              "作用",
              "例"
            ],
            "rows": [
              [
                "は",
                "提示主题（与已知信息对比）",
                "私は 学生です"
              ],
              [
                "も",
                "「也」",
                "私も 学生です"
              ],
              [
                "こそ",
                "强调",
                "これこそ 本物だ"
              ],
              [
                "しか（+否定）",
                "只…",
                "水しか 飲まない"
              ],
              [
                "だけ",
                "只",
                "一つだけ ある"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "「は」「も」会盖掉原来的格助词（が・を），但に・で 等可以叠用（には・でも）。"
