      {
        "id": "fr-noun-plural-al",
        "title": "<bdi>-al → -aux</bdi>",
        "inflect": "decl",
        "derive": {
          "pos": "noun",
          "stemExample": "cheval",
          "stemForms": {
            "pl": [
              {
                "pattern": "al$",
                "replace": "aux"
              }
            ]
          },
          "endings": {
            "main": {
              "m": {
                "sg": {
                  "stemOnly": true
                },
                "pl": {
                  "stemOnly": true,
                  "stemForm": "pl"
                }
              },
              "f": {
                "sg": {
                  "stemOnly": true
                },
                "pl": {
                  "stemOnly": true,
                  "stemForm": "pl"
                }
              }
