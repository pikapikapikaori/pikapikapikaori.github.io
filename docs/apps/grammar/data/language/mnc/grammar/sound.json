  {
    "id": "mnc-sound",
    "title": "语音与元音和谐",
    "items": [
      {
        "id": "mnc-sound-vowels",
        "title": "元音系统与分组",
        "tables": [
          {
            "caption": "元音分组（和谐的依据）",
            "role": "pattern",
            "headers": [
              "组",
              "元音",
              "说明"
            ],
            "rows": [
              [
                "后元音（阳性）",
                "<bdi>ᠠ a、ᡡ ū</bdi>",
                "搭配 -ha / -ra / -sa 型后缀"
              ],
              [
                "前元音（阴性）",
                "<bdi>ᡝ e、ᡠ u</bdi>",
                "搭配 -he / -re / -se 型后缀"
              ],
              [
                "圆唇元音",
                "<bdi>ᠣ o</bdi>",
                "搭配 -ho / -ro / -so 型后缀"
              ],
              [
                "中性元音",
                "<bdi>ᡳ i</bdi>",
                "不决定分组：向前找最近的非 i 元音，找不到时按前元音处理"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "ū（带长音符）属后元音，u 属前元音，二者是不同音位，拼写必须区分。"
      },
      {
        "id": "mnc-sound-harmony",
        "title": "元音和谐的作用范围",
        "tables": [
          {
            "caption": "受和谐影响的后缀",
            "role": "pattern",
            "headers": [
              "后缀",
              "后元音",
              "前元音",
              "圆唇"
            ],
            "rows": [
              [
                "过去时",
                "-ha",
                "-he",
                "-ho"
              ],
              [
                "将来时",
                "-ra",
                "-re",
                "-ro"
              ],
              [
                "否定",
                "-rakū",
                "-rekū",
                "-rokū"
              ],
              [
                "复数（-sa 型）",
                "-sa",
                "-se",
                "-so"
              ],
              [
                "复数（-ta 型）",
                "-ta",
                "-te",
                "-to"
              ],
              [
                "副动 -hai",
                "-hai",
                "-hei",
                "-hoi"
              ],
              [
                "副动 -tala",
                "-tala",
                "-tele",
                "-tolo"
              ],
              [
                "指小",
                "-kan",
                "-ken",
                "-kon"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "不受和谐影响的后缀（-kini / -cina / -<bdi>ᠪᡝ</bdi> / -de）用固定元音；派生词（-bu / -nu / -ca）接在词干后，后面的后缀按<strong>新词干</strong>的末元音继续和谐。"
      }
