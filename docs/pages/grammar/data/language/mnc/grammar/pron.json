[
  {
    "id": "mnc-pron",
    "title": "代词",
    "items": [
      {
        "id": "mnc-pron-personal",
        "title": "人称代词及格形式",
        "tables": [
          {
            "caption": "人称代词与格助词的结合形式",
            "role": "pattern",
            "headers": [
              "人称",
              "主格",
              "属格 -i/-ni",
              "与格-方位格 -de",
              "宾格 -be",
              "夺格 -ci"
            ],
            "rows": [
              [
                "第一人称单数 我",
                "ᠪᡳ",
                "ᠮᡳᠨᡳ",
                "ᠮᡳᠨᡩᡝ",
                "ᠮᡳᠮᠪᡝ",
                "ᠮᡳᠨᠴᡳ"
              ],
              [
                "第二人称单数 你",
                "ᠰᡳ",
                "ᠰᡳᠨᡳ",
                "ᠰᡳᠨᡩᡝ",
                "ᠰᡳᠮᠪᡝ",
                "ᠰᡳᠨᠴᡳ"
              ],
              [
                "第三人称单数 他/她",
                "ᡳ",
                "ᡳᠨᡳ",
                "ᡳᠨᡩᡝ",
                "ᡳᠮᠪᡝ",
                "ᡳᠨᠴᡳ"
              ],
              [
                "第一人称复数 排除（我们）",
                "ᠪᡝ",
                "ᠮᡝᠨᡳ",
                "ᠮᡝᠨᡩᡝ",
                "ᠮᡝᠮᠪᡝ",
                "ᠮᡝᠨᠴᡳ"
              ],
              [
                "第一人称复数 包括（咱们）",
                "ᠮᡠᠰᡝ",
                "ᠮᡠᠰᡝᡳ",
                "ᠮᡠᠰᡝᠩᡩᡝ",
                "ᠮᡠᠰᡝᠪᡝ",
                "ᠮᡠᠰᡝᠴᡳ"
              ],
              [
                "第二人称复数 你们",
                "ᠰᡠᠸᡝ",
                "ᠰᡠᠸᡝᠨᡳ",
                "ᠰᡠᠸᡝᠨᡩᡝ",
                "ᠰᡠᠸᡝᠮᠪᡝ",
                "ᠰᡠᠸᡝᠨᠴᡳ"
              ],
              [
                "第三人称复数 他们",
                "ᠴᡝ",
                "ᠴᡝᠨᡳ",
                "ᠴᡝᠨᡩᡝ",
                "ᠴᡝᠮᠪᡝ",
                "ᠴᡝᠨᠴᡳ"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "第一人称复数区分<strong>排除式</strong>（ᠪᡝ，不含听话者）与<strong>包括式</strong>（ᠮᡠᠰᡝ，含听话者）。代词本身不随格变化，而是接格助词；但接助词后多与词干缩合成异干形式（ᠪᡳ → ᠮᡳᠨᡳ / ᠮᡳᠨᡩᡝ / ᠮᡳᠮᠪᡝ / ᠮᡳᠨᠴᡳ），不能简单地把助词拼在原形后面。"
      },
      {
        "id": "mnc-pron-case-fusion",
        "title": "代词接格助词后的形式变化",
        "tables": [
          {
            "caption": "格助词接代词时发生的变化",
            "role": "pattern",
            "headers": [
              "格助词",
              "一般名词后",
              "代词后的变化",
              "例"
            ],
            "rows": [
              [
                "-i（属格-工具格）",
                "元音后接 -i，n 后接 -ni",
                "多用斜格词干 + -i / -ni",
                "ᠪᡳ → ᠮᡳᠨᡳ；ᡳ → ᡳᠨᡳ；ᠮᡠᠰᡝ → ᠮᡠᠰᡝᡳ；ᡨᡝᡵᡝ → ᡨᡝᡵᡝᡳ"
              ],
              [
                "-de（与格-方位格）",
                "直接接 -de",
                "斜格词干 + -de（常带 -n-）",
                "ᠪᡳ → ᠮᡳᠨᡩᡝ；ᠰᡳ → ᠰᡳᠨᡩᡝ；ᠮᡠᠰᡝ → ᠮᡠᠰᡝᠨᡩᡝ"
              ],
              [
                "-be（宾格）",
                "直接接 -be",
                "斜格词干 + -mbe / -be",
                "ᠪᡳ → ᠮᡳᠮᠪᡝ；ᠰᡳ → ᠰᡳᠮᠪᡝ；ᠮᡠᠰᡝ → ᠮᡠᠰᡝᠪᡝ"
              ],
              [
                "-ci（夺格）",
                "直接接 -ci",
                "斜格词干 + -ci（常带 -n-）",
                "ᠪᡳ → ᠮᡳᠨᠴᡳ；ᡳ → ᡳᠨᠴᡳ；ᠰᡠᠸᡝ → ᠰᡠᠸᡝᠨᠴᡳ"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "拿不准时优先记住整块形式（ᠮᡳᠨᡳ / ᠮᡳᠨᡩᡝ / ᠮᡳᠮᠪᡝ / ᠮᡳᠨᠴᡳ），不要临时拼；第三人称 i 的斜格词干是 in-，复数 ᠴᡝ 是 cen-。"
      },
      {
        "id": "mnc-pron-demonstrative",
        "title": "指示、疑问与反身代词",
        "tables": [
          {
            "caption": "常见形式",
            "role": "pattern",
            "headers": [
              "类别",
              "形式",
              "说明"
            ],
            "rows": [
              [
                "指示（近）",
                "ᡝᡵᡝ",
                "这；作定语直接放名词前"
              ],
              [
                "指示（远）",
                "ᡨᡝᡵᡝ",
                "那"
              ],
              [
                "疑问（人）",
                "ᠸᡝ",
                "谁"
              ],
              [
                "疑问（物）",
                "ᠶᠠ",
                "什么"
              ],
              [
                "疑问（选择）",
                "ᠠᡳ",
                "什么 / 哪个（多作定语）"
              ],
              [
                "反身",
                "ᠪᡝᠶᡝ",
                "自己（可接格助词，也可泛指「身体」）"
              ],
              [
                "相互",
                "ᡳᠰᡥᡠᠨᡩᡝ",
                "彼此"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "满语代词没有性、数的形态变化（第三人称复数用 ᠴᡝ），也不区分主格/宾格的词形，全靠格助词。"
      }
    ],
    "notes": null
  }
