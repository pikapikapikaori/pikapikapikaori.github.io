[
  {
    "id": "mnc-verb",
    "title": "动词",
    "items": [
      {
        "id": "mnc-verb-general",
        "title": "动词总论：-mbi 形式与词干",
        "tables": [
          {
            "caption": "动词的基本形态",
            "role": "pattern",
            "headers": [
              "项目",
              "形式",
              "说明"
            ],
            "rows": [
              [
                "词典形",
                "<bdi>ᠠᡵᠠᠮᠪᡳ</bdi>",
                "以 -<bdi>ᠮᠪᡳ</bdi> 结尾，兼表现在-将来时，也是词条的基本形态"
              ],
              [
                "词干",
                "<bdi>ᠠᡵᠠ-</bdi>",
                "去掉 -<bdi>ᠮᠪᡳ</bdi>；所有后缀都接在词干上（生词表单的「词干」）"
              ],
              [
                "否定",
                "<bdi>ᠠᡵᠠᡵᠠᡴᡡ</bdi>",
                "-<bdi>ᡵᠠ + -ᡴᡡ</bdi>，元音随词干和谐"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "满语动词只接后缀，不随人称变化（没有人称词尾）；后缀元音与<strong>词干最后一个元音</strong>和谐。"
      },
      {
        "id": "mnc-verb-tense",
        "title": "时制与体",
        "tables": [
          {
            "caption": "时制与体后缀（例：<bdi>ᠠᡵᠠᠮᠪᡳ</bdi> 写）",
            "role": "pattern",
            "headers": [
              "形式",
              "后缀",
              "例"
            ],
            "rows": [
              [
                "现在-将来",
                "<bdi>-ᠮᠪᡳ</bdi>",
                "<bdi>ᠠᡵᠠᠮᠪᡳ</bdi> 写 / 将写"
              ],
              [
                "将来 / 未完成",
                "<bdi>-ᡵᠠ / -ᡵᡝ / -ᡵᠣ</bdi>",
                "<bdi>ᠠᡵᠠᡵᠠ</bdi> 将要写"
              ],
              [
                "过去",
                "<bdi>-ᡥᠠ / -ᡥᡝ / -ᡥᠣ</bdi>",
                "<bdi>ᠠᡵᠠᡥᠠ</bdi> 写了"
              ],
              [
                "同时持续",
                "<bdi>-ᠮᠪᡳᠮᡝ</bdi>",
                "<bdi>ᠠᡵᠠᠮᠪᡳᠮᡝ</bdi> 一边写"
              ],
              [
                "过去进行",
                "<bdi>-ᠮᠪᡳᡥᡝ</bdi>",
                "<bdi>ᠠᡵᠠᠮᠪᡳᡥᡝ</bdi> 当时正在写"
              ],
              [
                "进行",
                "<bdi>-ᠮᡝ ᠪᡳ</bdi>",
                "<bdi>ᠠᡵᠠᠮᡝ ᠪᡳ</bdi> 正在写"
              ],
              [
                "进行/持续",
                "<bdi>-ᠮᡝ ᡳᠯᡳᡥᠠᠪᡳ</bdi>",
                "<bdi>ᠠᡵᠠᠮᡝ ᡳᠯᡳᡥᠠᠪᡳ</bdi> 保持着写的状态"
              ],
              [
                "完成/已毕",
                "<bdi>-ᠮᠠᡥᠠᠪᡳ</bdi>",
                "<bdi>ᠠᡵᠠᠮᠠᡥᠠᠪᡳ</bdi> 已经写了"
              ],
              [
                "完成",
                "<bdi>-ᡥᠠ ᠪᡳ</bdi>",
                "<bdi>ᠠᡵᠠᡥᠠ ᠪᡳ</bdi> 已经写了"
              ],
              [
                "过去完成",
                "<bdi>-ᡥᡝ ᠪᡳᡥᡝ</bdi>",
                "<bdi>ᠠᡵᠠᡥᡝ ᠪᡳᡥᡝ</bdi> 早已写了"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "<code><bdi>-ᡥᠠ ᠪᡳ</bdi></code> / <code><bdi>-ᡥᡝ ᠪᡳᡥᡝ</bdi></code> / <code><bdi>-ᠮᡝ ᠪᡳ</bdi></code> 这类是「后缀 + <bdi>ᠪᡳ / ᠪᡳᡥᡝ</bdi>」的复合形式，书写时中间有空格。"
      },
      {
        "id": "mnc-verb-mood",
        "title": "式：命令、祈愿、祈使",
        "tables": [
          {
            "caption": "式",
            "role": "pattern",
            "headers": [
              "形式",
              "后缀",
              "例"
            ],
            "rows": [
              [
                "命令（第二人称）",
                "词干本身",
                "<bdi>ᠠᡵᠠ</bdi> 写！"
              ],
              [
                "祈愿（第三人称）",
                "<bdi>-ᡴᡳᠨᡳ</bdi>",
                "<bdi>ᠠᡵᠠᡴᡳᠨᡳ</bdi> 愿他写"
              ],
              [
                "祈使（第一人称）",
                "<bdi>-ᠴᡳᠨᠠ</bdi>",
                "<bdi>ᠠᡵᠠᠴᡳᠨᠠ</bdi> 让我写吧"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "<bdi>-ᡴᡳᠨᡳ / -ᠴᡳᠨᠠ</bdi> 不随元音和谐变化；命令式的否定见「否定」一节的 <bdi>ᡠᠮᡝ</bdi>。"
      },
      {
        "id": "mnc-verb-negation",
        "title": "否定与禁止",
        "tables": [
          {
            "caption": "否定",
            "role": "pattern",
            "headers": [
              "形式",
              "后缀 / 结构",
              "例"
            ],
            "rows": [
              [
                "现在-将来否定",
                "<bdi>-ᡵᠠᡴᡡ / -ᡵᡝᡴᡡ / -ᡵᠣᡴᡡ</bdi>",
                "<bdi>ᠠᡵᠠᡵᠠᡴᡡ</bdi> 不写"
              ],
              [
                "过去否定",
                "<bdi>-ᡥᠠᡴᡡ / -ᡥᡝᡴᡡ / -ᡥᠣᡴᡡ</bdi>",
                "<bdi>ᠠᡵᠠᡥᠠᡴᡡ</bdi> 没写"
              ],
              [
                "禁止",
                "<bdi>ᡠᠮᡝ + -ᡵᠠ / -ᡵᡝ / -ᡵᠣ</bdi>",
                "<bdi>ᡠᠮᡝ ᠠᡵᠠᡵᠠ</bdi> 别写"
              ],
              [
                "名词性否定",
                "<bdi>ᠠᡴᡡ / ᠸᠠᡴᠠ</bdi>",
                "<bdi>ᠠᡴᡡ</bdi> 没有；<bdi>ᠸᠠᡴᠠ</bdi> 不是"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "否定后缀的元音同样随词干和谐；判断句否定用 <bdi>ᠸᠠᡴᠠ</bdi>，存在/拥有否定用 <bdi>ᠠᡴᡡ</bdi>。"
      },
      {
        "id": "mnc-verb-converb",
        "title": "副动形式（converb）",
        "tables": [
          {
            "caption": "副动后缀",
            "role": "pattern",
            "headers": [
              "形式",
              "后缀",
              "例"
            ],
            "rows": [
              [
                "同时",
                "<bdi>-ᠮᡝ</bdi>",
                "<bdi>ᠠᡵᠠᠮᡝ</bdi> 一边写"
              ],
              [
                "先后完成",
                "<bdi>-ᡶᡳ</bdi>",
                "<bdi>ᠠᡵᠠᡶᡳ</bdi> 写完之后"
              ],
              [
                "持续",
                "<bdi>-ᡥᠠᡳ / -ᡥᡝᡳ / -ᡥᠣᡳ</bdi>",
                "<bdi>ᠠᡵᠠᡥᠠᡳ</bdi> 一直写着"
              ],
              [
                "直到",
                "<bdi>-ᡨᠠᠯᠠ / -ᡨᡝᠯᡝ</bdi>",
                "<bdi>ᠠᡵᠠᡨᠠᠯᠠ</bdi> 写到…为止"
              ],
              [
                "当…时",
                "<bdi>-ᠩᡤᠠᠯᠠ / -ᠩᡤᡝᠯᡝ</bdi>",
                "<bdi>ᠠᡵᠠᠩᡤᠠᠯᠠ</bdi> 正要写的时候"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "副动形式不能单独作谓语，只能连接另一个动词或表示伴随状况。"
      },
      {
        "id": "mnc-verb-participle",
        "title": "形动形式与名词化",
        "tables": [
          {
            "caption": "形动与名词化",
            "role": "pattern",
            "headers": [
              "形式",
              "后缀",
              "例"
            ],
            "rows": [
              [
                "已发生（形动）",
                "<bdi>-ᡥᠠ / -ᡥᡝ / -ᡥᠣ</bdi>",
                "<bdi>ᠠᡵᠠᡥᠠ ᠨᡳᠶᠠᠯᠮᠠ</bdi> 写了的人"
              ],
              [
                "未发生（形动）",
                "<bdi>-ᡵᠠ / -ᡵᡝ / -ᡵᠣ</bdi>",
                "<bdi>ᠠᡵᠠᡵᠠ ᠨᡳᠶᠠᠯᠮᠠ</bdi> 要写的人"
              ],
              [
                "名词化 -<bdi>ᠨ</bdi>",
                "<bdi>-ᠨ</bdi>",
                "<bdi>ᠠᡵᠠᠨ</bdi> 写的这件事 / 情形"
              ],
              [
                "名词化 -<bdi>ᠰᡳ</bdi>",
                "<bdi>-ᠰᡳ</bdi>",
                "少数动词"
              ],
              [
                "名词化 -<bdi>ᡨᠠᠨ / -ᡨᡝᠨ</bdi>",
                "<bdi>-ᡨᠠᠨ / -ᡨᡝᠨ</bdi>",
                "少数动词"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "形动可直接修饰名词，也可作名词用；-<bdi>ᠨ / -ᠰᡳ / -ᡨᠠᠨ</bdi> 不太能产。"
      }
    ],
