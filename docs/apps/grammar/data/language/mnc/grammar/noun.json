        ],
        "inflect": "decl",
        "notes": "满语名词的复数<strong>多数不靠后缀</strong>：需要时用数词、形容词或上下文表示。只有指人名词较常用复数后缀；不确定时选这一类。",
        "derive": {
          "pos": "noun",
          "stemForms": {
            "base": {
              "from": "headword",
              "rules": []
            }
          },
          "stemExample": "niyalma",
          "headwordExample": "niyalma",
          "parts": [],
          "endings": {
            "number": {
              "abs": {
                "sg": {
                  "stemOnly": true
                },
                "pl": {
                  "stemOnly": true
                }
              }
            }
          },
          "expect": {
            "number": {
              "abs": {
                "sg": "ᠨᡳᠶᠠᠯᠮᠠ",
                "pl": "ᠨᡳᠶᠠᠯᠮᠠ"
              }
            }
          },
          "note": "满语名词的「词干」与基本形态（单数）相同，所以不需要另填；复数按所选的复数类型加后缀，后缀元音随词干和谐（见「元音和谐」一节）。"
        }
