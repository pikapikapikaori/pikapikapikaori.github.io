[
  {
    "id": "fr-adj",
    "title": "形容词",
    "items": [
      {
        "id": "fr-adj-rules",
        "title": "性数变化总表",
        "tables": [
          {
            "caption": "形容词的性数变化",
            "role": "pattern",
            "headers": [
              "形式",
              "单数阳性",
              "单数阴性",
              "复数阳性",
              "复数阴性"
            ],
            "rows": [
              [
                "一般",
                "<bdi>grand</bdi>",
                "<bdi>grande</bdi>",
                "<bdi>grands</bdi>",
                "<bdi>grandes</bdi>"
              ],
              [
                "-<bdi>e</bdi> 结尾",
                "<bdi>rouge</bdi>",
                "<bdi>rouge</bdi>",
                "<bdi>rouges</bdi>",
                "<bdi>rouges</bdi>"
              ],
              [
                "<bdi>-f → -ve</bdi>",
                "<bdi>actif</bdi>",
                "<bdi>active</bdi>",
                "<bdi>actifs</bdi>",
                "<bdi>actives</bdi>"
              ],
              [
                "<bdi>-x → -se</bdi>",
                "<bdi>heureux</bdi>",
                "<bdi>heureuse</bdi>",
                "<bdi>heureux</bdi>",
                "<bdi>heureuses</bdi>"
              ],
              [
                "<bdi>-er → -ère</bdi>",
                "<bdi>premier</bdi>",
                "<bdi>première</bdi>",
                "<bdi>premiers</bdi>",
                "<bdi>premières</bdi>"
              ],
              [
                "<bdi>-ien → -ienne</bdi>",
                "<bdi>ancien</bdi>",
                "<bdi>ancienne</bdi>",
                "<bdi>anciens</bdi>",
                "<bdi>anciennes</bdi>"
              ],
              [
                "<bdi>-on → -onne</bdi>",
                "<bdi>bon</bdi>",
                "<bdi>bonne</bdi>",
                "<bdi>bons</bdi>",
                "<bdi>bonnes</bdi>"
              ],
              [
                "<bdi>-el → -elle</bdi>",
                "<bdi>cruel</bdi>",
                "<bdi>cruelle</bdi>",
                "<bdi>cruels</bdi>",
                "<bdi>cruelles</bdi>"
              ],
              [
                "<bdi>-eil → -eille</bdi>",
                "<bdi>pareil</bdi>",
                "<bdi>pareille</bdi>",
                "<bdi>pareils</bdi>",
                "<bdi>pareilles</bdi>"
              ],
              [
                "-<bdi>s</bdi>（不变）",
                "<bdi>gras</bdi>",
                "<bdi>grasse</bdi>",
                "<bdi>gras</bdi>",
                "<bdi>grasses</bdi>"
              ]
            ]
          }
        ],
        "notes": "一般规则：阴性 + -e，复数 + -s，阴性复数 <bdi>+ -es</bdi>。以 -e 结尾的形容词阴阳同形。"
      },
      {
        "id": "fr-adj-regular",
        "title": "规则变化（+ -<bdi>e / + -s</bdi>）",
        "inflect": "decl",
        "derive": {
          "pos": "adj",
          "stemExample": "grand",
          "stemForms": {
            "f": [
              {
                "pattern": "$",
                "replace": "e"
              }
            ]
          },
          "endings": {
            "main": {
              "m": {
                "sg": {
                  "stemOnly": true
                },
                "pl": "-s"
              },
              "f": {
                "sg": {
                  "stemForm": "f",
                  "stemOnly": true
                },
                "pl": {
                  "stemForm": "f",
                  "suffix": "-s"
                }
              }
            }
          },
          "expect": {
            "main": {
              "m": {
                "sg": "grand",
                "pl": "grands"
              },
              "f": {
                "sg": "grande",
                "pl": "grandes"
              }
            }
          }
        },
        "tables": [
          {
            "caption": "词尾：规则变化",
            "role": "pattern",
            "headers": [
              "",
              "单数",
              "复数"
            ],
            "rows": [
              [
                "阳性",
                "—",
                "<bdi>+ -s</bdi>"
              ],
              [
                "阴性",
                "<bdi>+ -e</bdi>",
                "<bdi>+ -es</bdi>"
              ]
            ],
            "lang": "fr"
          },
          {
            "caption": "例词 <bdi>grand</bdi>",
            "role": "example",
            "headers": [
              "",
              "单数",
              "复数"
            ],
            "rows": [
              [
                "阳性",
                "<bdi>grand</bdi>",
                "<bdi>grands</bdi>"
              ],
              [
                "阴性",
                "<bdi>grande</bdi>",
                "<bdi>grandes</bdi>"
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "阳性单数后加 -e 得阴性、加 -s 得复数、加 <bdi>-es</bdi> 得阴性复数。"
      },
