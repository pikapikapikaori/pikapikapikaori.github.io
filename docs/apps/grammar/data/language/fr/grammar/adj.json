              [
                "颜色、国籍、分词类",
                "名词后",
                "<bdi>une voiture rouge</bdi>、<bdi>un livre français</bdi>"
              ],
              [
                "常用短形容词（<bdi>beau, grand, petit, jeune, bon</bdi>…）",
