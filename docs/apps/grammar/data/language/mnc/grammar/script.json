[
  {
    "id": "mnc-script",
    "title": "满文字母与书写",
    "items": [
      {
        "id": "mnc-script-vowels",
        "title": "元音字母（6）",
        "tables": [
          {
            "caption": "元音字母的四种位置形式",
            "role": "pattern",
            "headers": [
              "转写",
              "独立形",
              "词首形",
              "词中形",
              "词尾形",
              "说明"
            ],
            "rows": [
              [
                "a",
                "<bdi>‌ᠠ‌</bdi>",
                "<bdi>ᠠ‍</bdi>",
                "<bdi>‍ᠠ‍</bdi>",
                "<bdi>‍ᠠ</bdi>",
                "独立形与词首形不同（独立形多一笔）；单独成词时用独立形"
              ],
              [
                "e",
                "<bdi>‌ᡝ‌</bdi>",
                "<bdi>ᡝ‍</bdi>",
                "<bdi>‍ᡝ‍</bdi>",
                "<bdi>‍ᡝ</bdi>",
                "独立形与词首形不同；属前元音组"
              ],
              [
                "i",
                "<bdi>‌ᡳ‌</bdi>",
                "<bdi>ᡳ‍</bdi>",
                "<bdi>‍ᡳ‍</bdi>",
                "<bdi>‍ᡳ</bdi>",
                "独立形与词首形不同；中性元音"
              ],
              [
                "o",
                "<bdi>‌ᠣ‌</bdi>",
                "<bdi>ᠣ‍</bdi>",
                "<bdi>‍ᠣ‍</bdi>",
                "<bdi>‍ᠣ</bdi>",
                "圆唇元音，可单独成词（o = 「和」）"
              ],
              [
                "u",
                "<bdi>‌ᡠ‌</bdi>",
                "<bdi>ᡠ‍</bdi>",
                "<bdi>‍ᡠ‍</bdi>",
                "<bdi>‍ᡠ</bdi>",
                "前元音（与 e 同组）"
              ],
              [
                "ū",
                "<bdi>‌ᡡ‌</bdi>",
                "<bdi>ᡡ‍</bdi>",
                "<bdi>‍ᡡ‍</bdi>",
                "<bdi>‍ᡡ</bdi>",
                "后元音（与 a 同组），与 u 是两个不同字母"
              ]
            ],
            "lang": "mnc"
          }
        ]
      },
      {
        "id": "mnc-script-consonants",
        "title": "辅音字母（19）",
        "tables": [
          {
            "caption": "辅音字母的四种位置形式",
            "role": "pattern",
            "headers": [
              "转写",
              "独立形",
              "词首形",
              "词中形",
              "词尾形",
              "说明"
            ],
            "rows": [
              [
                "n",
                "<bdi>‌ᠨ‌</bdi>",
                "<bdi>ᠨ‍</bdi>",
                "<bdi>‍ᠨ‍</bdi>",
                "<bdi>‍ᠨ</bdi>",
                "词尾形带下撇"
              ],
              [
                "ng",
                "<bdi>‌ᠩ‌</bdi>",
                "<bdi>ᠩ‍</bdi>",
                "<bdi>‍ᠩ‍</bdi>",
                "<bdi>‍ᠩ</bdi>",
                "只用于词中、词尾，不能作词首"
              ],
              [
                "k",
                "<bdi>‌ᡴ‌</bdi>",
                "<bdi>ᡴ‍</bdi>",
                "<bdi>‍ᡴ‍</bdi>",
                "<bdi>‍ᡴ</bdi>",
                "与 g、h 共用基本字形：g 加点、h 加小圈；后接前元音（e / i / u）时字形变窄"
              ],
              [
                "g",
                "<bdi>‌ᡤ‌</bdi>",
                "<bdi>ᡤ‍</bdi>",
                "<bdi>‍ᡤ‍</bdi>",
                "<bdi>‍ᡤ</bdi>",
                "见 k"
              ],
              [
                "h",
                "<bdi>‌ᡥ‌</bdi>",
                "<bdi>ᡥ‍</bdi>",
                "<bdi>‍ᡥ‍</bdi>",
                "<bdi>‍ᡥ</bdi>",
                "见 k"
              ],
              [
                "b",
                "<bdi>‌ᠪ‌</bdi>",
                "<bdi>ᠪ‍</bdi>",
                "<bdi>‍ᠪ‍</bdi>",
                "<bdi>‍ᠪ</bdi>",
                "与 p 是两个不同字母，字形相近，不可混用"
              ],
              [
                "p",
                "<bdi>‌ᡦ‌</bdi>",
                "<bdi>ᡦ‍</bdi>",
                "<bdi>‍ᡦ‍</bdi>",
                "<bdi>‍ᡦ</bdi>",
                "见 b"
              ],
              [
                "s",
                "<bdi>‌ᠰ‌</bdi>",
                "<bdi>ᠰ‍</bdi>",
                "<bdi>‍ᠰ‍</bdi>",
                "<bdi>‍ᠰ</bdi>",
                "与 š 同为齿音，š 加区别符号"
              ],
              [
                "š",
                "<bdi>‌ᡧ‌</bdi>",
                "<bdi>ᡧ‍</bdi>",
                "<bdi>‍ᡧ‍</bdi>",
                "<bdi>‍ᡧ</bdi>",
                "见 s"
              ],
              [
                "t",
                "<bdi>‌ᡨ‌</bdi>",
                "<bdi>ᡨ‍</bdi>",
                "<bdi>‍ᡨ‍</bdi>",
                "<bdi>‍ᡨ</bdi>",
                "与 d 同基形"
              ],
              [
                "d",
                "<bdi>‌ᡩ‌</bdi>",
                "<bdi>ᡩ‍</bdi>",
                "<bdi>‍ᡩ‍</bdi>",
                "<bdi>‍ᡩ</bdi>",
                "在 t 的基形上加一点"
              ],
              [
                "m",
                "<bdi>‌ᠮ‌</bdi>",
                "<bdi>ᠮ‍</bdi>",
                "<bdi>‍ᠮ‍</bdi>",
                "<bdi>‍ᠮ</bdi>",
                "与 n、l 同族"
              ],
              [
                "l",
                "<bdi>‌ᠯ‌</bdi>",
                "<bdi>ᠯ‍</bdi>",
                "<bdi>‍ᠯ‍</bdi>",
                "<bdi>‍ᠯ</bdi>",
                "与 m、n 同族"
              ],
              [
                "r",
                "<bdi>‌ᡵ‌</bdi>",
                "<bdi>ᡵ‍</bdi>",
                "<bdi>‍ᡵ‍</bdi>",
                "<bdi>‍ᡵ</bdi>",
                "词尾形带下撇"
              ],
              [
                "j",
                "<bdi>‌ᠵ‌</bdi>",
                "<bdi>ᠵ‍</bdi>",
                "<bdi>‍ᠵ‍</bdi>",
                "<bdi>‍ᠵ</bdi>",
                "词中、词尾形带下撇"
              ],
              [
                "c",
                "<bdi>‌ᠴ‌</bdi>",
                "<bdi>ᠴ‍</bdi>",
                "<bdi>‍ᠴ‍</bdi>",
                "<bdi>‍ᠴ</bdi>",
                "词尾形带下撇"
              ],
              [
                "f",
                "<bdi>‌ᡶ‌</bdi>",
                "<bdi>ᡶ‍</bdi>",
                "<bdi>‍ᡶ‍</bdi>",
                "<bdi>‍ᡶ</bdi>",
                "词首形与词中形差别较大"
              ],
              [
                "w",
                "<bdi>‌ᠸ‌</bdi>",
                "<bdi>ᠸ‍</bdi>",
                "<bdi>‍ᠸ‍</bdi>",
                "<bdi>‍ᠸ</bdi>",
                "词尾形带下撇"
              ],
              [
                "y",
                "<bdi>‌ᠶ‌</bdi>",
                "<bdi>ᠶ‍</bdi>",
                "<bdi>‍ᠶ‍</bdi>",
                "<bdi>‍ᠶ</bdi>",
                "中性，可与前、后元音共现"
              ]
            ],
            "lang": "mnc"
          }
        ]
      },
      {
        "id": "mnc-script-loan",
        "title": "汉语借词字母（13）",
        "tables": [
          {
            "caption": "单字母的四种位置形式",
            "role": "pattern",
            "headers": [
              "转写",
              "独立形",
              "词首形",
              "词中形",
              "词尾形",
              "说明"
            ],
            "lang": "mnc",
            "rows": [
              [
                "y",
                "<bdi>‌ᡟ‌</bdi>",
                "<bdi>ᡟ‍</bdi>",
                "<bdi>‍ᡟ‍</bdi>",
                "<bdi>‍ᡟ</bdi>",
                "元音性的词尾 y，只出现在借词音节里（ᠰᡟ、ᡮᡟ 的后一半）"
              ],
              [
                "k'",
                "<bdi>‌ᠺ‌</bdi>",
                "<bdi>ᠺ‍</bdi>",
                "<bdi>‍ᠺ‍</bdi>",
                "—",
                "汉语 k [kʰ]，用在 a、o 前"
              ],
              [
                "g'",
                "<bdi>‌ᡬ‌</bdi>",
                "<bdi>ᡬ‍</bdi>",
                "<bdi>‍ᡬ‍</bdi>",
                "—",
                "汉语 g [k]，用在 a、o 前"
              ],
              [
                "h'",
                "<bdi>‌ᡭ‌</bdi>",
                "<bdi>ᡭ‍</bdi>",
                "<bdi>‍ᡭ‍</bdi>",
                "—",
                "汉语 h [x]，用在 a、o 前"
              ],
              [
                "ts'",
                "<bdi>‌ᡮ‌</bdi>",
                "<bdi>ᡮ‍</bdi>",
                "<bdi>‍ᡮ‍</bdi>",
                "—",
                "汉语 c [tsʰ]"
              ],
              [
                "dz",
                "<bdi>‌ᡯ‌</bdi>",
                "<bdi>ᡯ‍</bdi>",
                "<bdi>‍ᡯ‍</bdi>",
                "<bdi>‍ᡯ</bdi>",
                "汉语 z [ts]"
              ],
              [
                "ž",
                "<bdi>‌ᡰ‌</bdi>",
                "<bdi>ᡰ‍</bdi>",
                "<bdi>‍ᡰ‍</bdi>",
                "—",
                "汉语 r [ʐ]"
              ],
              [
                "c'",
                "<bdi>‌ᡱ‌</bdi>",
                "<bdi>ᡱ‍</bdi>",
                "<bdi>‍ᡱ‍</bdi>",
                "—",
                "汉语 ch [tʂʰ]"
              ],
              [
                "j'",
                "<bdi>‌ᡷ‌</bdi>",
                "<bdi>ᡷ‍</bdi>",
                "<bdi>‍ᡷ‍</bdi>",
                "—",
                "汉语 zh [tʂ]"
              ]
            ]
          },
          {
            "caption": "组合写法（字母 + 元音，不单独占键）",
            "role": "pattern",
            "headers": [
              "转写",
              "满文",
              "说明"
            ],
            "lang": "mnc",
            "rows": [
              [
                "ts'i",
                "<bdi>ᡮᡟ</bdi>",
                "汉语 ci，ts' 加 y"
              ],
              [
                "cy",
                "<bdi>ᡱᡳ</bdi>",
                "汉语 chi，c' 加 i"
              ],
              [
                "jy",
                "<bdi>ᡷᡳ</bdi>",
                "汉语 zhi，j' 加 i"
              ],
              [
                "sy",
                "<bdi>ᠰᡟ</bdi>",
                "汉语 si，s 加 y"
              ]
            ]
          }
        ]
      },
      {
        "id": "mnc-script-variants",
        "title": "同一字母的不同写法",
        "tables": [
          {
            "caption": "同一个字母按前后文取不同字形",
            "role": "pattern",
            "headers": [
              "字母",
              "一种形",
              "另一种形",
              "使用条件"
            ],
            "lang": "mnc",
            "rows": [
              [
                "e",
                "<bdi>‍ᡝ‍</bdi>",
                "<bdi>ᡴᡝ</bdi>",
                "k、g、h、d、t 之后的词中形不带点；t 之后另有词尾形，k、g、h 之后又是另一种"
              ],
              [
                "t",
                "<bdi>‍ᡨ‍</bdi>",
                "<bdi>ᡨᡝ</bdi>",
                "一般形、辅音前的形、e / u 前的形，三种"
              ],
              [
                "d",
                "<bdi>‍ᡩ‍</bdi>",
                "<bdi>ᡩᡝ</bdi>",
                "e、u 前用第二种形"
              ],
              [
                "k",
                "<bdi>ᡴᠠ</bdi>",
                "<bdi>ᡴᡝ</bdi>",
                "a、o、ū 前一种；e、i、u 前更窄的一种；辅音前再一种"
              ],
              [
                "g",
                "<bdi>ᡤᠠ</bdi>",
                "<bdi>ᡤᡝ</bdi>",
                "a、o、ū 前一种，e、i、u 前另一种"
              ],
              [
                "h",
                "<bdi>ᡥᠠ</bdi>",
                "<bdi>ᡥᡝ</bdi>",
                "a、o、ū 前一种，e、i、u 前另一种（小圈位置不同）"
              ],
              [
                "f",
                "<bdi>ᡶᠠ</bdi>",
                "<bdi>ᡶᠣ</bdi>",
                "a、e 前一种，o、u 前另一种"
              ],
              [
                "n",
                "<bdi>ᠨᠠ</bdi>",
                "<bdi>ᠨᠪ</bdi>",
                "元音前带点，辅音前不带点"
              ],
              [
                "a",
                "<bdi>ᠠ</bdi>",
                "<bdi>ᠪᠠ</bdi>",
                "b、p 之后另有第二种词尾形"
              ]
            ]
          }
        ]
      },
      {
        "id": "mnc-script-rules",
        "title": "书写与连接规则",
        "tables": [
          {
            "caption": "规则",
            "role": "pattern",
            "headers": [
              "规则",
              "说明"
            ],
            "lang": "mnc",
            "rows": [
              [
                "方向",
                "满文自上而下竖写，列自左向右（本表格为了排版改为横排）"
              ],
              [
                "连写",
                "一个词内部字母相连，不断开；词与词之间留空"
              ]
            ]
          }
        ]
      }
    ]
