[
  {
    "id": "grc-adv",
    "title": "副词",
    "items": [
      {
        "id": "grc-adv-comparison",
        "title": "副词的比较级与最高级",
        "tables": [
          {
            "caption": "构成规则",
            "role": "pattern",
            "headers": [
              "级别",
              "构成",
              "例"
            ],
            "rows": [
              [
                "原级",
                "形容词词干 + -ως（第一二变格）/ -ῶς（第三变格）",
                "σοφῶς 聪明地、ἀληθῶς 真实地"
              ],
              [
                "比较级",
                "比较级形容词的中性宾格单数（-τερον / -ιον）",
                "σοφώτερον、ἀληθέστερον"
              ],
              [
                "最高级",
                "最高级形容词的中性宾格复数（-τατα / -ιστα）",
                "σοφώτατα、ἀληθέστατα"
              ]
            ],
            "lang": "grc"
          },
          {
            "caption": "不规则",
            "role": "pattern",
            "headers": [
              "原级",
              "比较级",
              "最高级"
            ],
            "rows": [
              [
                "εὖ 好",
                "ἄμεινον / βέλτιον",
                "ἄριστα / βέλτιστα"
              ],
              [
                "κακῶς 坏",
                "χεῖρον / κάκιον",
                "κάκιστα"
              ],
              [
                "μάλα 很",
                "μᾶλλον",
                "μάλιστα"
              ],
              [
                "ταχέως 快",
                "θᾶττον",
                "τάχιστα"
              ]
            ],
            "lang": "grc"
          }
        ],
        "notes": "副词化时只用中性形式，因此副词本身没有性数格变化；比较对象用属格或 ἤ 引出。"
      },
      {
        "id": "grc-adv-place",
        "title": "方位副词（名词的三种方位形式）",
        "tables": [
          {
            "caption": "三种方位与词尾",
            "role": "pattern",
            "headers": [
              "方位",
              "词尾",
              "例"
            ],
            "rows": [
              [
                "位置（在哪）",
                "-οι / -θι",
                "οἴκοι 在家、Ἀθήνησι(ν) 在雅典、θύρασι 在门外"
              ],
              [
                "趋向（往哪）",
                "-δε / -σε",
                "οἴκαδε 回家、Ἀθήναζε 往雅典、ἄλαδε 向海"
              ],
              [
                "来源（从哪）",
                "-θεν",
                "οἴκοθεν 从家、Ἀθήνηθεν 从雅典、οὐρανόθεν 从天"
              ]
            ],
            "lang": "grc"
          },
          {
            "caption": "例词",
            "role": "example",
            "headers": [
              "名词",
              "位置",
              "趋向",
              "来源"
            ],
            "rows": [
              [
                "οἶκος 家",
                "οἴκοι",
                "οἴκαδε",
                "οἴκοθεν"
              ],
              [
                "Ἀθῆναι 雅典",
                "Ἀθήνησι(ν)",
                "Ἀθήναζε",
                "Ἀθήνηθεν"
              ],
              [
                "θάλασσα 海",
                "—",
                "θάλασσανδε / ἄλαδε",
                "θαλάσσηθεν"
              ],
              [
                "οὐρανός 天",
                "—",
                "οὐρανόνδε",
                "οὐρανόθεν"
              ]
            ],
            "lang": "grc"
          }
        ],
        "notes": "-δε / -σε 与 -θεν 直接加在名词词干（多为宾格 / 属格形式）后，属于构词而非变格，因此不需要格词尾。"
      },
      {
        "id": "grc-adv-kinds",
        "title": "常见副词分类",
        "tables": [
          {
            "caption": "按意义分类",
            "role": "pattern",
            "headers": [
              "类别",
              "例"
            ],
            "rows": [
              [
                "时间",
                "νῦν 现在、τότε 那时、αἰεί 永远、ἤδη 已经、αὖθις 再"
              ],
              [
                "地点",
                "ἐνθάδε 这里、ἐκεῖ 那里、πανταχοῦ 到处、ἔσω 在内"
              ],
              [
                "方式",
                "οὕτως 这样、ὡς 如、ἅμα 同时、σφόδρα 非常"
              ],
              [
                "程度",
                "μάλα 很、πάνυ 十分、ἥκιστα 最少"
              ],
              [
                "语气",
                "δή 的确、γε 至少、μέν / δέ 一方面 / 另一方面"
              ],
              [
                "否定",
                "οὐ / οὐκ / οὐχ 不、μή 不（非陈述）、οὐκέτι 不再"
              ]
            ],
            "lang": "grc"
          }
        ],
        "notes": "副词没有形态变化（比较等级除外）；否定副词 οὐ 用于陈述句，μή 用于祈使、虚拟、祈愿与条件句。"
      }
    ]
  }
]
