                "<bdi>-ᡵᠣ</bdi>"
              ],
              [
                "否定",
                "<bdi>-ᡵᠠᡴᡡ</bdi>",
                "<bdi>-ᡵᡝᡴᡡ</bdi>",
                "<bdi>-ᡵᠣᡴᡡ</bdi>"
              ],
              [
                "复数（-ᠰᠠ 型）",
                "<bdi>-ᠰᠠ</bdi>",
                "<bdi>-ᠰᡝ</bdi>",
                "<bdi>-ᠰᠣ</bdi>"
              ],
              [
                "复数（-ᡨᠠ 型）",
                "<bdi>-ᡨᠠ</bdi>",
                "<bdi>-ᡨᡝ</bdi>",
                "<bdi>-ᡨᠣ</bdi>"
              ],
              [
                "副动 -ᡥᠠᡳ",
                "<bdi>-ᡥᠠᡳ</bdi>",
                "<bdi>-ᡥᡝᡳ</bdi>",
                "<bdi>-ᡥᠣᡳ</bdi>"
              ],
              [
                "副动 -ᡨᠠᠯᠠ",
                "<bdi>-ᡨᠠᠯᠠ</bdi>",
                "<bdi>-ᡨᡝᠯᡝ</bdi>",
                "<bdi>-ᡨᠣᠯᠣ</bdi>"
              ],
              [
                "指小",
                "<bdi>-ᡴᠠᠨ</bdi>",
                "<bdi>-ᡴᡝᠨ</bdi>",
                "<bdi>-ᡴᠣᠨ</bdi>"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "不受和谐影响的后缀（<bdi>-ᡴᡳᠨᡳ</bdi> / <bdi>-ᠴᡳᠨᠠ</bdi> / <bdi>-ᠪᡝ</bdi> / <bdi>-ᡩᡝ</bdi>）用固定元音；派生词（<bdi>-ᠪᡠ</bdi> / <bdi>-ᠨᡠ</bdi> / <bdi>-ᠴᠠ</bdi>）接在词干后，后面的后缀按<strong>新词干</strong>的末元音继续和谐。"
      }
