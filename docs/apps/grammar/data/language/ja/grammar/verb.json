[
  {
    "id": "ja-verb",
    "title": "动词总论",
    "items": [
      {
        "id": "ja-verb-overview",
        "title": "活用形体系与四类动词",
        "tables": [
          {
            "caption": "活用形（学校文法）",
            "role": "pattern",
            "headers": [
              "活用形",
              "作用",
              "五段 <bdi>書く</bdi>",
              "一段 <bdi>食べる</bdi>",
              "<bdi>する</bdi>",
              "<bdi>来る</bdi>"
            ],
            "rows": [
              [
                "未然形",
                "接 <bdi>ない・う/よう・れる・せる</bdi>",
                "<bdi>書か</bdi>",
                "<bdi>食べ</bdi>",
                "<bdi>し / せ / さ</bdi>",
                "<bdi>こ</bdi>"
              ],
              [
                "連用形1",
                "接 <bdi>ます・たい・ながら</bdi>",
                "<bdi>書き</bdi>",
                "<bdi>食べ</bdi>",
                "<bdi>し</bdi>",
                "<bdi>き</bdi>"
              ],
              [
                "連用形2（音便）",
                "接 <bdi>て・た</bdi>",
                "<bdi>書い</bdi>",
                "<bdi>食べ</bdi>",
                "<bdi>し</bdi>",
                "<bdi>き</bdi>"
              ],
              [
                "終止形（辞書形）",
                "结句",
                "<bdi>書く</bdi>",
                "<bdi>食べる</bdi>",
                "<bdi>する</bdi>",
                "<bdi>くる</bdi>"
              ],
              [
                "連体形",
                "修饰名词",
                "<bdi>書く</bdi>",
                "<bdi>食べる</bdi>",
                "<bdi>する</bdi>",
                "<bdi>くる</bdi>"
              ],
              [
                "已然形（仮定）",
                "接 <bdi>ば</bdi>",
                "<bdi>書け</bdi>",
                "<bdi>食べれ</bdi>",
                "<bdi>すれ</bdi>",
                "<bdi>くれ</bdi>"
              ],
              [
                "命令形",
                "命令",
                "<bdi>書け</bdi>",
                "<bdi>食べろ</bdi>",
                "<bdi>しろ / せよ</bdi>",
                "<bdi>こい</bdi>"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "动词按活用方式分<strong>四类</strong>：<bdi>五段・一段・サ変（する）・カ変（来る）。連用形2（音便）只在五段与 て/た 结合时才有独立形状（書い / 書いて</bdi>），其余三类与連用形1 同形。"
      },
      {
        "id": "ja-verb-compound",
        "title": "合成形式的构成",
        "tables": [
          {
            "caption": "形式与活用形的对应",
            "role": "pattern",
            "headers": [
              "形式",
              "构成",
              "例（<bdi>書く</bdi>）"
            ],
            "rows": [
              [
                "<bdi>ます形</bdi>（叮咛）",
                "連用形1 + <bdi>ます</bdi>",
                "<bdi>書きます</bdi>"
              ],
              [
                "<bdi>ない形</bdi>",
                "未然形 + <bdi>ない</bdi>",
                "<bdi>書かない</bdi>"
              ],
              [
                "<bdi>た形</bdi>",
                "連用形2 + <bdi>た</bdi>",
                "<bdi>書いた</bdi>"
              ],
              [
                "<bdi>て形</bdi>",
                "連用形2 + <bdi>て</bdi>",
                "<bdi>書いて</bdi>"
              ],
              [
                "意志形",
                "未然形 + <bdi>う / よう</bdi>",
                "<bdi>書こう</bdi>"
              ],
              [
                "可能形",
                "五段：已然形 + <bdi>る；一段等：未然形 + られる</bdi>",
                "<bdi>書ける / 食べられる</bdi>"
              ],
              [
                "受身形",
                "未然形 + <bdi>れる / られる</bdi>",
                "<bdi>書かれる</bdi>"
              ],
              [
                "使役形",
                "未然形 + <bdi>せる / させる</bdi>",
                "<bdi>書かせる</bdi>"
              ],
              [
                "使役受身形",
                "未然形 + <bdi>せられる / させられる</bdi>",
                "<bdi>書かせられる</bdi>"
              ],
              [
                "仮定形＋<bdi>ば</bdi>",
                "已然形 + <bdi>ば</bdi>",
                "<bdi>書けば</bdi>"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "口语里可能形与使役受身形有缩约形：<bdi>食べられる → 食べれる、書かせられる → 書かされる</bdi>。"
      }
    ]
  },
