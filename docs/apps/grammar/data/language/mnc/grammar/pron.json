[
  {
    "id": "mnc-pron",
    "title": "代词",
    "items": [
      {
        "id": "mnc-pron-personal",
        "title": "人称代词及格形式",
        "tables": [
          {
            "caption": "人称代词与格助词的结合形式",
            "role": "pattern",
            "headers": [
              "人称",
              "主格",
              "属格 -<bdi>ᡳ/-ᠨᡳ</bdi>",
              "与格-方位格 -<bdi>ᡩᡝ</bdi>",
              "宾格 -<bdi>ᠪᡝ</bdi>",
              "夺格 -<bdi>ᠴᡳ</bdi>"
            ],
            "rows": [
              [
                "第一人称单数 我",
                "<bdi>ᠪᡳ</bdi>",
                "<bdi>ᠮᡳᠨᡳ</bdi>",
                "<bdi>ᠮᡳᠨᡩᡝ</bdi>",
                "<bdi>ᠮᡳᠮᠪᡝ</bdi>",
                "<bdi>ᠮᡳᠨᠴᡳ</bdi>"
              ],
              [
                "第二人称单数 你",
                "<bdi>ᠰᡳ</bdi>",
                "<bdi>ᠰᡳᠨᡳ</bdi>",
                "<bdi>ᠰᡳᠨᡩᡝ</bdi>",
                "<bdi>ᠰᡳᠮᠪᡝ</bdi>",
                "<bdi>ᠰᡳᠨᠴᡳ</bdi>"
              ],
              [
                "第三人称单数 他/她",
                "<bdi>ᡳ</bdi>",
                "<bdi>ᡳᠨᡳ</bdi>",
                "<bdi>ᡳᠨᡩᡝ</bdi>",
                "<bdi>ᡳᠮᠪᡝ</bdi>",
                "<bdi>ᡳᠨᠴᡳ</bdi>"
              ],
              [
                "第一人称复数 排除（我们）",
                "<bdi>ᠪᡝ</bdi>",
                "<bdi>ᠮᡝᠨᡳ</bdi>",
                "<bdi>ᠮᡝᠨᡩᡝ</bdi>",
                "<bdi>ᠮᡝᠮᠪᡝ</bdi>",
                "<bdi>ᠮᡝᠨᠴᡳ</bdi>"
              ],
              [
                "第一人称复数 包括（咱们）",
                "<bdi>ᠮᡠᠰᡝ</bdi>",
                "<bdi>ᠮᡠᠰᡝᡳ</bdi>",
                "<bdi>ᠮᡠᠰᡝᠩᡩᡝ</bdi>",
                "<bdi>ᠮᡠᠰᡝᠪᡝ</bdi>",
                "<bdi>ᠮᡠᠰᡝᠴᡳ</bdi>"
              ],
              [
                "第二人称复数 你们",
                "<bdi>ᠰᡠᠸᡝ</bdi>",
                "<bdi>ᠰᡠᠸᡝᠨᡳ</bdi>",
                "<bdi>ᠰᡠᠸᡝᠨᡩᡝ</bdi>",
                "<bdi>ᠰᡠᠸᡝᠮᠪᡝ</bdi>",
                "<bdi>ᠰᡠᠸᡝᠨᠴᡳ</bdi>"
              ],
              [
                "第三人称复数 他们",
                "<bdi>ᠴᡝ</bdi>",
                "<bdi>ᠴᡝᠨᡳ</bdi>",
                "<bdi>ᠴᡝᠨᡩᡝ</bdi>",
                "<bdi>ᠴᡝᠮᠪᡝ</bdi>",
                "<bdi>ᠴᡝᠨᠴᡳ</bdi>"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "第一人称复数区分<strong>排除式</strong>（<bdi>ᠪᡝ</bdi>，不含听话者）与<strong>包括式</strong>（<bdi>ᠮᡠᠰᡝ</bdi>，含听话者）。代词本身不随格变化，而是接格助词；但接助词后多与词干缩合成异干形式（<bdi>ᠪᡳ → ᠮᡳᠨᡳ / ᠮᡳᠨᡩᡝ / ᠮᡳᠮᠪᡝ / ᠮᡳᠨᠴᡳ</bdi>），不能简单地把助词拼在原形后面。"
      },
      {
        "id": "mnc-pron-case-fusion",
        "title": "代词接格助词后的形式变化",
        "tables": [
          {
            "caption": "格助词接代词时发生的变化",
            "role": "pattern",
            "headers": [
              "格助词",
              "一般名词后",
              "代词后的变化",
              "例"
            ],
            "rows": [
              [
                "-<bdi>ᡳ</bdi>（属格-工具格）",
                "元音后接 -<bdi>ᡳ</bdi>，<bdi>ᠨ</bdi> 后接 <bdi>-ᠨᡳ</bdi>",
                "多用斜格词干 + -<bdi>ᡳ / -ᠨᡳ</bdi>",
                "<bdi>ᠪᡳ → ᠮᡳᠨᡳ</bdi>；<bdi>ᡳ → ᡳᠨᡳ</bdi>；<bdi>ᠮᡠᠰᡝ → ᠮᡠᠰᡝᡳ</bdi>；<bdi>ᡨᡝᡵᡝ → ᡨᡝᡵᡝᡳ</bdi>"
              ],
              [
                "-<bdi>ᡩᡝ</bdi>（与格-方位格）",
                "直接接 -<bdi>ᡩᡝ</bdi>",
                "斜格词干 + -<bdi>ᡩᡝ</bdi>（常带 <bdi>-ᠨ</bdi>-）",
                "<bdi>ᠪᡳ → ᠮᡳᠨᡩᡝ</bdi>；<bdi>ᠰᡳ → ᠰᡳᠨᡩᡝ</bdi>；<bdi>ᠮᡠᠰᡝ → ᠮᡠᠰᡝᠨᡩᡝ</bdi>"
              ],
              [
                "-<bdi>ᠪᡝ</bdi>（宾格）",
                "直接接 -<bdi>ᠪᡝ</bdi>",
                "斜格词干 + -<bdi>ᠮᠪᡝ / -ᠪᡝ</bdi>",
                "<bdi>ᠪᡳ → ᠮᡳᠮᠪᡝ</bdi>；<bdi>ᠰᡳ → ᠰᡳᠮᠪᡝ</bdi>；<bdi>ᠮᡠᠰᡝ → ᠮᡠᠰᡝᠪᡝ</bdi>"
              ],
              [
                "-<bdi>ᠴᡳ</bdi>（夺格）",
                "直接接 -<bdi>ᠴᡳ</bdi>",
                "斜格词干 + -<bdi>ᠴᡳ</bdi>（常带 <bdi>-ᠨ</bdi>-）",
                "<bdi>ᠪᡳ → ᠮᡳᠨᠴᡳ</bdi>；<bdi>ᡳ → ᡳᠨᠴᡳ</bdi>；<bdi>ᠰᡠᠸᡝ → ᠰᡠᠸᡝᠨᠴᡳ</bdi>"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "拿不准时优先记住整块形式（<bdi>ᠮᡳᠨᡳ / ᠮᡳᠨᡩᡝ / ᠮᡳᠮᠪᡝ / ᠮᡳᠨᠴᡳ</bdi>），不要临时拼；第三人称 <bdi>ᡳ</bdi> 的斜格词干是 <bdi>ᡳᠨ-</bdi>，复数 <bdi>ᠴᡝ</bdi> 是 <bdi>ᠴᡝᠨ</bdi>-。"
      },
      {
        "id": "mnc-pron-demonstrative",
        "title": "指示、疑问与反身代词",
        "tables": [
          {
            "caption": "常见形式",
            "role": "pattern",
            "headers": [
              "类别",
              "形式",
              "说明"
            ],
            "rows": [
              [
                "指示（近）",
                "<bdi>ᡝᡵᡝ</bdi>",
                "这；作定语直接放名词前"
              ],
              [
                "指示（远）",
                "<bdi>ᡨᡝᡵᡝ</bdi>",
                "那"
              ],
              [
                "疑问（人）",
                "<bdi>ᠸᡝ</bdi>",
                "谁"
              ],
              [
                "疑问（物）",
                "<bdi>ᠶᠠ</bdi>",
                "什么"
              ],
              [
                "疑问（选择）",
                "<bdi>ᠠᡳ</bdi>",
                "什么 / 哪个（多作定语）"
              ],
              [
                "反身",
                "<bdi>ᠪᡝᠶᡝ</bdi>",
                "自己（可接格助词，也可泛指「身体」）"
              ],
              [
                "相互",
                "<bdi>ᡳᠰᡥᡠᠨᡩᡝ</bdi>",
                "彼此"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "满语代词没有性、数的形态变化（第三人称复数用 <bdi>ᠴᡝ</bdi>），也不区分主格/宾格的词形，全靠格助词。"
      }
    ]
  }
]
