        "tables": [
          {
            "caption": "元音分组（和谐的依据）",
            "role": "pattern",
            "headers": [
              "组",
              "元音",
              "说明"
            ],
            "rows": [
              [
                "后元音（阳性）",
                "<bdi>ᠠ</bdi>、<bdi>ᡡ</bdi>",
                "搭配 <bdi>-ᡥᠠ / -ᡵᠠ / -ᠰᠠ</bdi> 型后缀"
              ],
              [
                "前元音（阴性）",
                "<bdi>ᡝ</bdi>、<bdi>ᡠ</bdi>",
                "搭配 <bdi>-ᡥᡝ / -ᡵᡝ / -ᠰᡝ</bdi> 型后缀"
              ],
              [
                "圆唇元音",
                "<bdi>ᠣ</bdi>",
                "搭配 <bdi>-ᡥᠣ / -ᡵᠣ / -ᠰᠣ</bdi> 型后缀"
              ],
              [
                "中性元音",
                "<bdi>ᡳ</bdi>",
                "不决定分组：向前找最近的非 i 元音，找不到时按前元音处理"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "ū（带长音符）属后元音，u 属前元音，二者是不同音位，拼写必须区分。"
