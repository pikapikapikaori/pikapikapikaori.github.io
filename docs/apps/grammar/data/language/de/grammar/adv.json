        "notes": "规则副词用 -er / am …-sten 构成比较级与最高级（与形容词同形）。下表是常用的不规则形式。"
      },
      {
        "id": "de-adv-pronominal",
        "title": "代副词 da(r)- 与 wo(r)-",
        "tables": [
          {
            "caption": "构成与用法",
            "role": "pattern",
            "headers": [
              "形式",
              "用途",
              "例"
            ],
            "rows": [
              [
                "da + 介词",
                "代替「介词 + 事物」",
                "damit、dafür、darüber"
              ],
              [
                "da + r + 元音开头介词",
                "介词以元音开头时插入 r",
                "darauf、daran、darum"
              ],
              [
                "wo + 介词",
                "对「介词 + 事物」提问",
                "womit、wovon、worüber"
              ],
              [
                "wo + r + 元音开头介词",
                "同上",
                "worauf、woran、worin"
              ]
            ],
            "lang": "de"
          },
          {
            "caption": "人 vs 物",
            "role": "pattern",
            "headers": [
              "所指",
              "用什么",
              "例"
            ],
            "rows": [
              [
                "指物",
                "代副词",
                "Worauf wartest du? — Auf den Bus."
              ],
              [
                "指人",
                "介词 + 人称代词",
                "Auf wen wartest du? — Auf meinen Freund."
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "da(r)- / wo(r)- 只用于指物；指人时要用「介词 + 人称代词」。"
      }
    ]
