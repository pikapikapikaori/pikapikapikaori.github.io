              [
                "名词否定",
                "<bdi>ᠠᡴᡡ / ᠸᠠᡴᠠ</bdi>",
                "<bdi>ᠠᡴᡡ</bdi> 没有；<bdi>ᠸᠠᡴᠠ</bdi> 不是"
              ],
              [
                "名词并列",
                "A B（直接并置）",
                "很少用连词"
              ],
              [
                "动词并列",
                "-<bdi>ᠮᡝ / -ᡶᡳ</bdi> 副动形式",
