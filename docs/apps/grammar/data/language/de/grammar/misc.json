            ],
            "rows": [
              [
                "<bdi>aus</bdi>",
                "<bdi>aus dem Haus</bdi>"
              ],
              [
                "<bdi>bei</bdi>",
                "<bdi>bei mir</bdi>"
              ],
              [
                "<bdi>mit</bdi>",
                "<bdi>mit dem Freund</bdi>"
              ],
              [
                "<bdi>nach</bdi>",
                "<bdi>nach der Schule</bdi>"
              ],
              [
                "<bdi>seit</bdi>",
                "<bdi>seit einem Jahr</bdi>"
              ],
              [
                "<bdi>von</bdi>",
                "<bdi>von der Arbeit</bdi>"
              ],
              [
