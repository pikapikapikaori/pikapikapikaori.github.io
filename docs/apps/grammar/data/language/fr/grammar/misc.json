            ],
            "rows": [
              [
                "一般",
                "<bdi>le</bdi>",
                "<bdi>la</bdi>",
                "<bdi>les</bdi>"
              ],
              [
                "元音前",
                "<bdi>l'</bdi>",
                "<bdi>l'</bdi>",
                "<bdi>les</bdi>"
              ]
            ]
          }
        ],
        "notes": "<bdi>le / la / les</bdi> 在元音或哑音 h 前省音（<bdi>l'ami</bdi>）。与介词缩合的形式见「缩合冠词」。"
      },
      {
        "id": "fr-article-indefinite",
        "title": "不定冠词与部分冠词",
        "tables": [
          {
            "caption": "不定冠词",
            "role": "pattern",
            "headers": [
              "",
              "阳性",
              "阴性",
              "复数"
            ],
            "rows": [
              [
                "一般",
                "<bdi>un</bdi>",
                "<bdi>une</bdi>",
                "<bdi>des</bdi>"
              ]
            ]
          },
          {
            "caption": "部分冠词",
            "role": "pattern",
            "headers": [
              "",
              "阳性",
              "阴性"
            ],
            "rows": [
              [
                "一般",
                "<bdi>du</bdi>",
                "<bdi>de la</bdi>"
              ],
              [
                "元音前",
                "<bdi>de l'</bdi>",
                "<bdi>de l'</bdi>"
              ]
            ]
          }
        ],
        "notes": "否定句里不定冠词与部分冠词通常变为 <bdi>de</bdi>（<bdi>Je n'ai pas de pain</bdi>）。"
      },
      {
        "id": "fr-article-contraction",
        "title": "缩合冠词",
        "tables": [
          {
            "caption": "介词 + 定冠词的缩合",
            "role": "pattern",
            "headers": [
              "组合",
              "结果",
              "例"
            ],
            "rows": [
              [
                "<bdi>de + le</bdi>",
                "<bdi>du</bdi>",
                "<bdi>du livre</bdi>"
              ],
              [
                "<bdi>de + les</bdi>",
                "<bdi>des</bdi>",
                "<bdi>des livres</bdi>"
              ],
              [
                "<bdi>à + le</bdi>",
                "<bdi>au</bdi>",
                "<bdi>au marché</bdi>"
              ],
              [
                "<bdi>à + les</bdi>",
                "<bdi>aux</bdi>",
                "<bdi>aux enfants</bdi>"
              ],
              [
                "<bdi>de + la / de + l'</bdi>",
                "不缩合",
                "<bdi>de la table / de l'eau</bdi>"
              ],
              [
                "<bdi>à + la / à + l'</bdi>",
                "不缩合",
                "<bdi>à la plage / à l'école</bdi>"
              ],
              [
                "<bdi>de + un / une / des</bdi>",
                "不缩合（不定冠词）",
                "<bdi>de un → d'un</bdi>（省音），<bdi>une / des</bdi> 不变"
              ]
            ]
          }
        ],
        "notes": "只有阳性单数 <bdi>le</bdi> 与复数 <bdi>les</bdi> 才与 <bdi>de / à</bdi> 缩合；阴性 <bdi>la</bdi> 与省音形式 l' 不缩合。"
      }
    ]
  },
  {
    "id": "fr-orthography",
    "title": "正字法",
    "items": [
      {
        "id": "fr-orthography-accents",
        "title": "音符与特殊字符",
        "tables": [
          {
            "caption": "五种音符",
            "role": "pattern",
            "headers": [
              "音符",
              "名称",
              "作用",
              "例"
            ],
            "rows": [
              [
                "<bdi>é</bdi>",
                "<bdi>accent aigu</bdi>（闭音符）",
                "只出现在 e 上，表示 [e]",
                "<bdi>été</bdi>、<bdi>parler</bdi>"
              ],
              [
                "<bdi>è / ê</bdi>",
                "<bdi>accent grave / circonflexe</bdi>",
                "表示 [ɛ]；<bdi>ê</bdi> 常来自历史上消失的 s",
                "<bdi>père</bdi>、<bdi>forêt</bdi>（<bdi>forest</bdi>）"
              ],
              [
                "<bdi>à / ù</bdi>",
                "<bdi>accent grave</bdi>",
                "只用来区分同形词",
                "<bdi>à</bdi>（介词）、<bdi>où</bdi>（哪里）"
              ],
              [
                "<bdi>â / î / ô / û</bdi>",
                "<bdi>accent circonflexe</bdi>",
                "标记历史上的长音或消失的字母",
                "<bdi>âme</bdi>、<bdi>île</bdi>、<bdi>hôtel</bdi>、<bdi>dû</bdi>"
              ],
              [
                "<bdi>ë / ï / ü</bdi>",
                "<bdi>tréma</bdi>（分音符）",
                "表示与前一元音分开读，不构成双元音",
                "<bdi>Noël</bdi>、<bdi>maïs</bdi>、<bdi>aiguë</bdi>"
              ],
              [
                "<bdi>ç</bdi>",
                "<bdi>cédille</bdi>（软音符）",
                "让 c 在 <bdi>a / o / u</bdi> 前读 [s]",
                "<bdi>français</bdi>、<bdi>reçu</bdi>、<bdi>leçon</bdi>"
              ],
              [
                "<bdi>œ</bdi>",
                "<bdi>ligature</bdi>",
                "<bdi>o + e</bdi> 的合字",
                "<bdi>cœur</bdi>、<bdi>œuf</bdi>、<bdi>sœur</bdi>"
              ]
            ],
            "lang": "fr"
          },
          {
            "caption": "易混词",
            "role": "pattern",
            "headers": [
              "带音符",
              "不带音符",
              "区别"
            ],
            "rows": [
              [
                "<bdi>à</bdi>（介词）",
                "a（<bdi>avoir</bdi> 的第三人称单数）",
                "<bdi>Il a à faire.</bdi>"
              ],
              [
                "<bdi>ou</bdi>（或者）",
                "<bdi>où</bdi>（哪里）",
                "<bdi>Tu viens ou non ? / Où es-tu ?</bdi>"
              ],
              [
                "<bdi>la</bdi>（冠词）",
                "<bdi>là</bdi>（那里）",
                "<bdi>la table / là-bas</bdi>"
              ],
              [
                "<bdi>sur</bdi>（在…上）",
                "<bdi>sûr</bdi>（确定的）",
                "<bdi>sur la table / je suis sûr</bdi>"
              ],
              [
                "<bdi>du</bdi>（部分冠词）",
                "<bdi>dû</bdi>（<bdi>devoir</bdi> 的过去分词）",
                "<bdi>du pain / j'ai dû partir</bdi>"
              ],
              [
                "<bdi>notre</bdi>（我们的）",
                "<bdi>nôtre</bdi>（物主代词）",
                "<bdi>notre maison / le nôtre</bdi>"
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "音符是拼写的一部分，不能省略；打字时可以用输入法的法语布局或组合键。"
      },
      {
        "id": "fr-orthography-elision",
        "title": "省音（<bdi>élision</bdi>）",
        "tables": [
          {
            "caption": "省音",
            "role": "pattern",
            "headers": [
              "原形式",
              "省音后",
              "例"
            ],
            "rows": [
              [
                "<bdi>le / la +</bdi> 元音或哑音 h",
                "<bdi>l'</bdi>",
                "<bdi>l'ami</bdi>、<bdi>l'heure</bdi>"
              ],
              [
                "<bdi>je</bdi> + 元音",
                "<bdi>j'</bdi>",
                "<bdi>j'arrive</bdi>"
              ],
              [
                "<bdi>me / te / se</bdi> + 元音",
                "<bdi>m' / t' / s'</bdi>",
                "<bdi>il m'aime</bdi>"
              ],
              [
                "<bdi>ne</bdi> + 元音",
                "<bdi>n'</bdi>",
                "<bdi>il n'a pas</bdi>"
              ],
              [
                "<bdi>de</bdi> + 元音",
                "<bdi>d'</bdi>",
                "<bdi>d'accord</bdi>"
              ],
              [
                "<bdi>que</bdi> + 元音",
                "<bdi>qu'</bdi>",
                "<bdi>qu'il vienne</bdi>"
              ],
              [
                "<bdi>ce</bdi> + 元音",
                "<bdi>c'</bdi>",
                "<bdi>c'est</bdi>"
              ],
              [
                "<bdi>jusque</bdi> + 元音",
                "<bdi>jusqu'</bdi>",
                "<bdi>jusqu'ici</bdi>"
              ],
              [
                "<bdi>lorsque / puisque / quoique</bdi>",
                "<bdi>lorsqu' / puisqu' / quoiqu'</bdi>",
                "<bdi>lorsqu'il arrive</bdi>"
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "哑音 h（<bdi>heure</bdi>、<bdi>homme</bdi>、<bdi>histoire</bdi>）要省音；嘘音 h（<bdi>héros</bdi>、<bdi>hasard</bdi>、<bdi>hibou</bdi>）不省音：<bdi>le héros</bdi>。数字 <bdi>onze / onzième</bdi> 前也不省音（<bdi>le onze</bdi>）。"
      },
      {
        "id": "fr-orthography-hyphen",
        "title": "连字符（<bdi>trait d'union</bdi>）",
        "tables": [
          {
            "caption": "必须用连字符的情况",
            "role": "pattern",
            "headers": [
