  {
    "id": "grc-contraction",
    "title": "元音缩合规则",
    "items": [
      {
        "id": "grc-contraction-rules",
        "title": "缩合表",
        "tables": [
          {
            "caption": "α 与后续元音",
            "role": "pattern",
            "headers": [
              "α +",
              "ε / η",
              "ει / ῃ",
              "ο / ου / ω",
              "οι / ῳ"
            ],
            "rows": [
              [
                "结果",
                "ᾱ",
                "ᾳ",
                "ω",
                "ῳ"
              ]
            ],
            "lang": "grc"
          },
          {
            "caption": "ε 与后续元音",
            "role": "pattern",
            "headers": [
              "ε +",
              "ε",
              "η",
              "ει / ῃ",
              "ο",
              "ου",
              "ω",
              "οι / ῳ"
            ],
            "rows": [
              [
                "结果",
                "ει",
                "η",
                "ει",
                "ου",
                "ου",
                "ω",
                "οι"
              ]
            ],
            "lang": "grc"
          },
          {
            "caption": "ο 与后续元音",
            "role": "pattern",
            "headers": [
              "ο +",
              "ε / η",
              "ει / ῃ",
              "ο",
              "ου / ω",
              "οι / ῳ"
            ],
            "rows": [
              [
                "结果",
                "ου",
                "οι",
                "ου",
                "ου",
                "οι"
              ]
            ],
            "lang": "grc"
          }
        ],
        "notes": "元音缩合只发生在词内相邻的两个元音之间（词干与词尾的接合处），缩合后产生长元音、双元音或带下标的元音。缩合动词（见动词章）与部分名词（γένος 型、-εύς 型）都靠这套规则。"
      },
      {
        "id": "grc-contraction-examples",
        "title": "缩合举例",
        "tables": [
          {
            "caption": "动词（φιλέω 爱）",
            "role": "pattern",
            "headers": [
              "未缩合",
              "缩合",
              "说明"
            ],
            "rows": [
              [
                "φιλέ-ω",
                "φιλῶ",
                "ε + ω → ω"
              ],
              [
                "φιλέ-εις",
                "φιλεῖς",
                "ε + ει → ει"
              ],
              [
                "φιλέ-ομεν",
                "φιλοῦμεν",
                "ε + ο → ου"
              ],
              [
                "ἐφίλε-ον",
                "ἐφίλουν",
                "ε + ο → ου"
              ],
              [
                "τιμά-ω",
                "τιμῶ",
                "α + ω → ω"
              ],
              [
                "τιμά-ομεν",
                "τιμῶμεν",
                "α + ο → ω"
              ],
              [
                "δηλό-ω",
                "δηλῶ",
                "ο + ω → ω"
              ],
              [
                "δηλό-ομεν",
                "δηλοῦμεν",
                "ο + ο → ου"
              ]
            ],
            "lang": "grc"
          },
          {
            "caption": "名词",
            "role": "pattern",
            "headers": [
              "未缩合",
              "缩合",
              "说明"
            ],
            "rows": [
              [
                "γένεσ-ος",
                "γένους",
                "ε + ο → ου"
              ],
              [
                "γένεσ-ι",
                "γένει",
                "ε + ι → ει"
              ],
              [
                "γένεσ-α",
                "γένη",
                "ε + α → η"
              ],
              [
                "βασιλέϝ-ος",
                "βασιλέως",
                "ε + ο → εω"
              ],
              [
                "ἀληθέσ-ος",
                "ἀληθοῦς",
                "ε + ο → ου"
              ]
            ],
            "lang": "grc"
          }
        ],
        "notes": "双写词尾时注意重音：缩合音节原本带重音时结果音节取弯曲重音（φιλέ-ω → φιλῶ）。"
      }
    ]
  },
  {
    "id": "grc-accent",
    "title": "重音规则",
    "items": [
      {
        "id": "grc-accent-basic",
        "title": "三种重音与限制法",
        "tables": [
          {
            "caption": "重音符号",
            "role": "pattern",
            "headers": [
              "名称",
              "符号",
              "说明"
            ],
            "rows": [
              [
                "锐重音",
                "ά",
                "大多数情况；写在元音上"
              ],
              [
                "弯曲重音",
                "ᾶ",
                "只出现在末音节或倒数第二音节，且倒数第二带弯曲重音时末音节必须短"
              ],
              [
                "粗气符",
                "ἁ",
                "词首元音送气，不是重音"
              ],
              [
                "柔气符",
                "ἀ",
                "词首元音不送气，不是重音"
              ]
            ],
            "lang": "grc"
          },
          {
            "caption": "限制法（law of limitation）",
            "role": "pattern",
            "headers": [
              "情形",
              "规则"
            ],
            "rows": [
              [
                "倒数第三音节",
                "只有末音节短时才允许；只能是锐重音"
              ],
              [
                "倒数第二音节",
                "该音节长（长元音或双元音）且末音节短时为弯曲重音，否则为锐重音"
              ],
              [
                "末音节",
                "锐重音（oxytone）或弯曲重音（perispomenon）"
              ]
            ],
            "lang": "grc"
          }
        ],
        "notes": "重音只能落在最后三个音节之内。判断音节长短时，末尾的 -αι / -οι 与 -εως / -εων 按短音算；祈愿式的词尾 -οι / -αι 则按长音算（λύοι 与不定式 λῦσαι 的区别）。词末的 -ξ / -ψ 与两个以上辅音使音节按位置变长。"
      },
      {
        "id": "grc-accent-types",
        "title": "动词退重音与名词持续重音",
        "tables": [
          {
            "caption": "两类重音",
            "role": "pattern",
            "headers": [
              "类别",
              "规则",
              "例"
            ],
            "rows": [
              [
                "动词（退重音）",
                "在限制法允许的范围内尽量往词首推",
                "λύω / λύομεν / λυόμεθα / λέλυκα / ἐλέλυτο"
              ],
              [
                "名词形容词（持续重音）",
                "重音保持在基本形态所在的音节上，只受限制法约束",
                "λόγος / λόγου / ἀνθρώπου / πόλεως"
              ],
              [
                "重音无关的形式",
                "不定式 -ναι / -σθαι、分词 -θείς / -κώς / -μένος 等有固定重音",
                "λυθῆναι、λελύσθαι、λυθείς、λελυκώς"
              ]
            ],
            "lang": "grc"
          }
        ],
        "notes": "生词表单的「生成表格」按这里的两条规则自动放置重音：数据里只用 ᾱ ῑ ῡ 标注元音长短，生成结果中这些标注会被去掉。"
      }
    ]
  },
