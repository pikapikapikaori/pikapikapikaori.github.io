              [
                "增音 <bdi>अ-</bdi> 加在 <bdi>इ / उ / ऋ</bdi> 开头的词根前",
                "三合元音（<bdi>ऐ / औ / आर्</bdi>）",
                "<bdi>इच्छति → ऐच्छत्</bdi>"
              ]
            ],
            "lang": "sa"
          },
          {
            "caption": "送气音（Grassmann 定律）",
            "role": "pattern",
            "headers": [
              "情况",
              "结果",
              "例"
            ],
            "rows": [
              [
                "两个送气音同处一个音节",
                "第一个失去送气",
                "<bdi>बुध् + त → बुद्ध</bdi>；<bdi>लभ् + त → लब्ध</bdi>"
              ],
              [
                "后接咝音",
                "第二个的送气先「让」给第一个",
                "duh + si → dhokṣi（但 duh + tha → dugdha）"
              ]
            ],
            "lang": "sa"
          },
          {
            "caption": "词尾 -<bdi>क् / -ट्</bdi>",
            "role": "pattern",
            "headers": [
              "后接",
              "结果",
              "例"
            ],
            "rows": [
              [
                "鼻音",
                "<bdi>ट् → ण्</bdi>，<bdi>क् → ञ्</bdi>",
                "<bdi>विराट् + न → विराण्न</bdi>；<bdi>वाक् + मे → वाञ्मे</bdi>"
              ],
              [
                "浊音",
                "<bdi>ट् → ड्</bdi>，<bdi>क् → ग्</bdi>",
                "<bdi>वणिक् + ददाति → वणिग्ददाति</bdi>；<bdi>हव्यवाट् + आगच्छति → हव्यवाडागच्छति</bdi>"
              ],
              [
                "<bdi>ह</bdi>",
                "<bdi>ड्ढ् / ग्घ्</bdi>",
                "<bdi>प्रावृट् + हि → प्रावृड्ढि</bdi>；<bdi>वणिक् + हि → वणिग्घि</bdi>"
              ]
            ],
            "lang": "sa"
          },
          {
            "caption": "齿音卷舌",
            "role": "pattern",
            "headers": [
              "情况",
              "结果",
              "例"
            ],
            "rows": [
              [
                "<bdi>ष्</bdi> 后紧跟 <bdi>त</bdi>",
                "<bdi>ट</bdi>",
                "<bdi>द्विष् + त → द्विष्ट</bdi>"
