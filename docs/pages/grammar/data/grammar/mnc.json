    "sections": [
        {
            "id": "mnc-script",
            "title": "满文字母形态",
            "items": [
                {
                    "id": "mnc-letter-a-initial",
                    "title": "元音字母 a 的四种形态",
                    "tables": [
                        {
                            "caption": "满文元音 a 的形态",
                            "headers": [
                                "位置",
                                "形式",
                                "罗马化"
                            ],
                            "rows": [
                                [
                                    "独立形 (Isolated)",
                                    "ᠠ",
                                    "a"
                                ],
                                [
                                    "词首形 (Initial)",
                                    "ᠠ",
                                    "a-"
                                ],
                                [
                                    "词中形 (Medial)",
                                    "ᠠ",
                                    "-a-"
                                ],
                                [
                                    "词尾形 (Final)",
                                    "ᠠ",
                                    "-a"
                                ]
                            ]
                        }
                    ],
                    "notes": "满文元音字母的独立形与词首形通常相同。词尾形与前接辅音字形相连。"
                },
                {
                    "id": "mnc-letter-e-initial",
                    "title": "元音字母 e 的四种形态",
                    "tables": [
                        {
                            "caption": "满文元音 e 的形态",
                            "headers": [
                                "位置",
                                "形式",
                                "罗马化"
                            ],
                            "rows": [
                                [
                                    "独立形",
                                    "ᡝ",
                                    "e"
                                ],
                                [
                                    "词首形",
                                    "ᡝ",
                                    "e-"
                                ],
                                [
                                    "词中形",
                                    "ᡝ",
                                    "-e-"
                                ],
                                [
                                    "词尾形",
                                    "ᡝ",
                                    "-e"
                                ]
                            ]
                        }
                    ],
                    "notes": "元音 e 的形态与 a 类似，但字形不同。e 属于前元音组，与 u 一起参与元音和谐。"
                },
                {
                    "id": "mnc-letter-i-initial",
                    "title": "元音字母 i 的四种形态",
                    "tables": [
                        {
                            "caption": "满文元音 i 的形态",
                            "headers": [
                                "位置",
                                "形式",
                                "罗马化"
                            ],
                            "rows": [
                                [
                                    "独立形",
                                    "ᡳ",
                                    "i"
                                ],
                                [
                                    "词首形",
                                    "ᡳ",
                                    "i-"
                                ],
                                [
                                    "词中形",
                                    "ᡳ",
                                    "-i-"
                                ],
                                [
                                    "词尾形",
                                    "ᡳ",
                                    "-i"
                                ]
                            ]
                        }
                    ],
                    "notes": "i 是中性元音，可与前元音或后元音共现。"
                },
                {
                    "id": "mnc-letter-o-initial",
                    "title": "元音字母 o 的四种形态",
                    "tables": [
                        {
                            "caption": "满文元音 o 的形态",
                            "headers": [
                                "位置",
                                "形式",
                                "罗马化"
                            ],
                            "rows": [
                                [
                                    "独立形",
                                    "ᠣ",
                                    "o"
                                ],
                                [
                                    "词首形",
                                    "ᠣ",
                                    "o-"
                                ],
                                [
                                    "词中形",
                                    "ᠣ",
                                    "-o-"
                                ],
                                [
                                    "词尾形",
                                    "ᠣ",
                                    "-o"
                                ]
                            ]
                        }
                    ],
                    "notes": "o 是后元音，与 a、ū 同组参与元音和谐。"
                },
                {
                    "id": "mnc-letter-u-initial",
                    "title": "元音字母 u 的四种形态",
                    "tables": [
                        {
                            "caption": "满文元音 u 的形态",
                            "headers": [
                                "位置",
                                "形式",
                                "罗马化"
                            ],
                            "rows": [
                                [
                                    "独立形",
                                    "ᡠ",
                                    "u"
                                ],
                                [
                                    "词首形",
                                    "ᡠ",
                                    "u-"
                                ],
                                [
                                    "词中形",
                                    "ᡠ",
                                    "-u-"
                                ],
                                [
                                    "词尾形",
                                    "ᡠ",
                                    "-u"
                                ]
                            ]
                        }
                    ],
                    "notes": "u 是前元音（「阴性元音」），与 e 同组参与元音和谐。满文的 ū 用 ᡡ 表示。"
                },
                {
                    "id": "mnc-letter-n-initial",
                    "title": "辅音字母 n 的形态",
                    "tables": [
                        {
                            "caption": "满文辅音 n 的形态",
                            "headers": [
                                "位置",
                                "形式",
                                "罗马化"
                            ],
                            "rows": [
                                [
                                    "独立形",
                                    "ᠨ",
                                    "n"
                                ],
                                [
                                    "词首形",
                                    "ᠨ",
                                    "n-"
                                ],
                                [
                                    "词中形",
                                    "ᠨ",
                                    "-n-"
                                ],
                                [
                                    "词尾形",
                                    "ᠨ",
                                    "-n"
                                ]
                            ]
                        }
                    ],
                    "notes": "辅音字母一般有词首、词中、词尾三种形式；元音字母和部分音节字母有四种形式。"
                },
                {
                    "id": "mnc-letter-k-initial",
                    "title": "辅音字母 k 的形态",
                    "tables": [
                        {
                            "caption": "满文辅音 k 的形态",
                            "headers": [
                                "位置",
                                "形式（后元音前）",
                                "形式（前元音前）",
                                "罗马化"
                            ],
                            "rows": [
                                [
                                    "独立形",
                                    "ᡴ",
                                    "ᡴ",
                                    "k"
                                ],
                                [
                                    "词首形",
                                    "ᡴ",
                                    "ᡴ",
                                    "k-"
                                ],
                                [
                                    "词中形",
                                    "ᡴ",
                                    "ᡴ",
                                    "-k-"
                                ],
                                [
                                    "词尾形",
                                    "ᡴ",
                                    "ᡴ",
                                    "-k"
                                ]
                            ]
                        }
                    ],
                    "notes": "k / g / h 三个字母共用基本字形：g 在 k 的字形右侧加点，h 在 k 的字形右侧加小圈。同一 Unicode 码位，字形随前接元音由字体自动选择。"
                },
                {
                    "id": "mnc-letter-b-initial",
                    "title": "辅音字母 b 的形态",
                    "tables": [
                        {
                            "caption": "满文辅音 b 的形态",
                            "headers": [
