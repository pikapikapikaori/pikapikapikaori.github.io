[
  {
    "id": "ja-syntax",
    "title": "句法",
    "items": [
      {
        "id": "ja-syntax-order",
        "title": "基本语序",
        "tables": [
          {
            "caption": "SOV",
            "role": "pattern",
            "headers": [
              "成分",
              "例",
              "说明"
            ],
            "rows": [
              [
                "主 + 宾 + 谓",
                "私は 本を 読む",
                "谓语在句末"
              ],
              [
                "修饰语在被修饰语前",
                "高い 山",
                "形容词、名词の、从句都在前"
              ],
              [
                "状语位置较自由",
                "昨日 東京で 友達と 会った",
                "时间・地点・对象依次在谓语前"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "日语的语序是<strong>SOV</strong>，谓语固定在句末；成分之间靠助词标示关系，所以语序相对自由。"
      },
      {
        "id": "ja-syntax-copula",
        "title": "判断句与否定",
        "tables": [
          {
            "caption": "判断句",
            "role": "pattern",
            "headers": [
              "类型",
              "普通体",
              "叮咛体"
            ],
            "rows": [
              [
                "肯定（名词）",
                "学生だ",
                "学生です"
              ],
              [
                "否定（名词）",
                "学生ではない",
                "学生ではありません"
              ],
              [
                "肯定（形容动词）",
                "静かだ",
                "静かです"
              ],
              [
                "否定（形容动词）",
                "静かではない",
                "静かではありません"
              ]
            ],
            "lang": "ja"
          },
          {
            "caption": "动词否定",
            "role": "pattern",
            "headers": [
              "形式",
              "例"
            ],
            "rows": [
              [
                "普通体",
                "書かない"
              ],
              [
                "叮咛体",
                "書きません"
              ],
              [
                "过去否定",
                "書かなかった / 書きませんでした"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "名词与形容动词的「だ」是否定与过去时的变化载体；形容词与动词自带活用。"
      },
      {
        "id": "ja-syntax-question",
        "title": "疑问与其他",
        "tables": [
          {
            "caption": "疑问",
            "role": "pattern",
            "headers": [
              "手段",
              "例"
            ],
            "rows": [
              [
                "终助词 か",
                "学生ですか"
              ],
              [
                "疑问词 + か",
                "何を 食べますか"
              ],
              [
                "疑问词 + も（+否定）",
                "何も 食べません"
              ]
            ],
            "lang": "ja"
          },
          {
            "caption": "其他特征",
            "role": "pattern",
            "headers": [
              "特点",
              "例"
            ],
            "rows": [
              [
                "省略主语（语境明了时）",
                "（私は）行きます"
              ],
              [
                "敬语由动词形式与句式承担",
                "いらっしゃる / お待ちになる"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "日语疑问句通常在句末加「か」，语序不变（不前置疑问词）。"
      }
    ]
  }
]
