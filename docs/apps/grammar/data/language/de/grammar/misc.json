                "<bdi>einer</bdi>",
                "<bdi>einem</bdi>",
                "—"
              ],
              [
                "宾格",
                "<bdi>einen</bdi>",
                "<bdi>eine</bdi>",
                "<bdi>ein</bdi>",
                "—"
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "不定冠词没有复数形式，复数用 <bdi>kein 或零冠词。否定形式 kein 变格与不定冠词相同（kein, keine, kein, keine）；物主代词（mein, dein, sein</bdi> 等）也按此变格。"
      }
    ]
  },
  {
