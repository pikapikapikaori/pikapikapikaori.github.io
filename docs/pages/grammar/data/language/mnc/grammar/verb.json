          ]
        }
      },
      "stemExample": "ara",
      "headwordExample": "arambi",
      "parts": [
        {
          "key": "base",
          "label": "词干（去掉 -mbi）",
          "example": "ara",
          "required": false,
          "hint": "留空时由基本形态去掉 -mbi 自动推出。"
