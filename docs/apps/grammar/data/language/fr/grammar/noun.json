            "rows": [
              [
                "一般名词",
                "<bdi>+ -s</bdi>"
              ],
              [
                "-<bdi>s</bdi> 的读音",
                "不发音"
              ],
              [
                "单复数区分",
                "靠限定词"
              ]
            ],
            "lang": "fr"
          },
          {
            "caption": "例词",
            "role": "example",
            "headers": [
              "单数",
              "复数"
