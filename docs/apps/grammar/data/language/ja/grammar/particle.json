[
  {
    "id": "ja-particle",
    "title": "助词",
    "items": [
      {
        "id": "ja-particle-case",
        "title": "格助词",
        "tables": [
          {
            "caption": "格助词",
            "role": "pattern",
            "headers": [
              "助词",
              "作用",
              "例"
            ],
            "rows": [
              [
                "<bdi>が</bdi>",
                "主语（新信息）",
                "<bdi>雨が 降っている</bdi>"
              ],
              [
                "<bdi>を</bdi>",
                "宾语",
                "<bdi>本を 読む</bdi>"
              ],
              [
                "<bdi>に</bdi>",
                "<bdi>时间・目的地・接受者</bdi>",
                "<bdi>七時に 行く</bdi>"
              ],
              [
                "<bdi>で</bdi>",
                "<bdi>场所・手段</bdi>",
                "<bdi>図書館で 勉強する</bdi>"
              ],
              [
                "<bdi>へ</bdi>",
                "方向",
                "<bdi>東京へ 行く</bdi>"
              ],
              [
                "<bdi>から</bdi>",
                "起点",
                "<bdi>家から 出る</bdi>"
              ],
              [
                "<bdi>まで</bdi>",
                "终点",
                "<bdi>駅まで 歩く</bdi>"
              ],
              [
                "<bdi>の</bdi>",
                "<bdi>所属・修饰</bdi>",
                "<bdi>学生の</bdi> 本"
              ],
              [
                "<bdi>と</bdi>",
                "<bdi>共同・引用</bdi>",
                "<bdi>友達と 行く</bdi>"
              ],
              [
                "<bdi>より</bdi>",
                "比较基准",
                "<bdi>私より 高い</bdi>"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "格助词接在名词短语后，表示该名词与谓语的语法关系。"
      },
      {
        "id": "ja-particle-topic",
        "title": "提示助词",
        "tables": [
          {
            "caption": "提示助词",
            "role": "pattern",
            "headers": [
              "助词",
              "作用",
              "例"
            ],
            "rows": [
              [
                "<bdi>は</bdi>",
                "提示主题（与已知信息对比）",
                "<bdi>私は 学生です</bdi>"
              ],
              [
                "<bdi>も</bdi>",
                "「也」",
                "<bdi>私も 学生です</bdi>"
              ],
              [
                "<bdi>こそ</bdi>",
                "强调",
                "<bdi>これこそ 本物だ</bdi>"
              ],
              [
                "<bdi>しか</bdi>（+否定）",
                "只…",
                "<bdi>水しか 飲まない</bdi>"
              ],
              [
                "<bdi>だけ</bdi>",
                "只",
                "<bdi>一つだけ ある</bdi>"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "<bdi>「は」「も」会盖掉原来的格助词（が・を），但に・で 等可以叠用（には・でも）。</bdi>"
      },
      {
        "id": "ja-particle-final",
        "title": "终助词与接续助词",
        "tables": [
          {
            "caption": "终助词",
            "role": "pattern",
            "headers": [
              "助词",
              "作用",
              "例"
            ],
            "rows": [
              [
                "<bdi>か</bdi>",
                "疑问",
                "<bdi>学生ですか</bdi>"
              ],
              [
                "<bdi>ね</bdi>",
                "<bdi>确认・共鸣</bdi>",
                "<bdi>いいですね</bdi>"
              ],
              [
                "<bdi>よ</bdi>",
                "告知",
                "<bdi>ありますよ</bdi>"
              ],
              [
                "<bdi>な / なあ</bdi>",
                "<bdi>感叹・自言自语</bdi>",
                "<bdi>きれいだな</bdi>"
              ]
            ],
            "lang": "ja"
          },
          {
            "caption": "接续助词",
            "role": "pattern",
            "headers": [
              "助词",
              "作用",
              "例"
            ],
            "rows": [
              [
                "<bdi>て</bdi>",
                "<bdi>顺接・并列</bdi>",
                "<bdi>食べて 寝た</bdi>"
              ],
              [
                "<bdi>が</bdi>",
                "逆接",
                "<bdi>高いが 買った</bdi>"
              ],
              [
                "<bdi>から</bdi>",
                "原因",
                "<bdi>寒いから 帰る</bdi>"
              ],
              [
                "<bdi>ので</bdi>",
                "原因（委婉）",
                "<bdi>寒いので 帰ります</bdi>"
              ],
              [
                "<bdi>と / ば / たら / なら</bdi>",
                "条件",
                "<bdi>行くと 分かる</bdi>"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "接续助词接在活用形之后（<bdi>て 接連用形2、ば</bdi> 接已然形），所以也归在「接续」这一层。"
      }
    ]
  }
]
