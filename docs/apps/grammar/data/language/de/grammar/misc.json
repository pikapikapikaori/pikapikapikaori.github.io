              "位置（<bdi>Wo? → Dat</bdi>.）"
            ],
            "rows": [
              [
                "<bdi>an</bdi>",
                "<bdi>an die Wand</bdi>",
                "<bdi>an der Wand</bdi>"
              ],
              [
                "<bdi>auf</bdi>",
                "<bdi>auf den Tisch</bdi>",
                "<bdi>auf dem Tisch</bdi>"
              ],
              [
                "<bdi>hinter</bdi>",
                "<bdi>hinter das Haus</bdi>",
                "<bdi>hinter dem Haus</bdi>"
              ],
              [
                "<bdi>in</bdi>",
                "<bdi>in die Schule</bdi>",
                "<bdi>in der Schule</bdi>"
              ],
              [
                "<bdi>neben</bdi>",
                "<bdi>neben den Tisch</bdi>",
                "<bdi>neben dem Tisch</bdi>"
              ],
              [
                "<bdi>über</bdi>",
                "<bdi>über den See</bdi>",
                "<bdi>über dem See</bdi>"
              ],
              [
                "<bdi>unter</bdi>",
                "<bdi>unter den Tisch</bdi>",
                "<bdi>unter dem Tisch</bdi>"
              ],
              [
                "<bdi>vor</bdi>",
                "<bdi>vor das Haus</bdi>",
                "<bdi>vor dem Haus</bdi>"
              ],
              [
                "<bdi>zwischen</bdi>",
                "<bdi>zwischen die Häuser</bdi>",
                "<bdi>zwischen den Häusern</bdi>"
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "含缩合形式：<bdi>an + dem = am、in + dem = im、an + das = ans、in + das = ins</bdi> 等。"
      },
      {
        "id": "de-prep-genitive",
        "title": "带属格的介词",
        "tables": [
          {
            "caption": "<bdi>Genitiv</bdi>",
            "role": "pattern",
            "headers": [
              "介词",
              "例"
            ],
            "rows": [
              [
                "<bdi>wegen</bdi>",
                "<bdi>wegen des Regens</bdi>"
              ],
              [
                "<bdi>trotz</bdi>",
                "<bdi>trotz des Verbots</bdi>"
              ],
              [
                "<bdi>während</bdi>",
                "<bdi>während des Unterrichts</bdi>"
              ],
              [
                "<bdi>statt / anstatt</bdi>",
                "<bdi>statt des Buches</bdi>"
              ],
              [
                "<bdi>außerhalb</bdi>",
                "<bdi>außerhalb der Stadt</bdi>"
              ],
