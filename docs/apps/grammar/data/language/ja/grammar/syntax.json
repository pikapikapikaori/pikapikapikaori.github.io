[
  {
    "id": "ja-syntax",
    "title": "句法",
    "items": [
      {
        "id": "ja-syntax-order",
        "title": "基本语序",
        "tables": [
          {
            "caption": "SOV",
            "role": "pattern",
            "headers": [
              "成分",
              "例",
              "说明"
            ],
            "rows": [
              [
                "主 + 宾 + 谓",
                "<bdi>私は 本を 読む</bdi>",
                "谓语在句末"
              ],
              [
                "修饰语在被修饰语前",
                "<bdi>高い</bdi> 山",
                "形容词、<bdi>名词の</bdi>、从句都在前"
              ],
              [
                "状语位置较自由",
                "昨日 <bdi>東京で 友達と 会った</bdi>",
                "<bdi>时间・地点・对象依次在谓语前</bdi>"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "日语的语序是<strong>SOV</strong>，谓语固定在句末；成分之间靠助词标示关系，所以语序相对自由。"
      },
      {
        "id": "ja-syntax-copula",
        "title": "判断句与否定",
        "tables": [
          {
            "caption": "判断句",
            "role": "pattern",
            "headers": [
              "类型",
              "普通体",
              "叮咛体"
            ],
            "rows": [
              [
                "肯定（名词）",
                "<bdi>学生だ</bdi>",
                "<bdi>学生です</bdi>"
              ],
              [
                "否定（名词）",
                "<bdi>学生ではない</bdi>",
                "<bdi>学生ではありません</bdi>"
              ],
              [
                "肯定（形容动词）",
                "<bdi>静かだ</bdi>",
                "<bdi>静かです</bdi>"
              ],
              [
                "否定（形容动词）",
                "<bdi>静かではない</bdi>",
                "<bdi>静かではありません</bdi>"
              ]
            ],
            "lang": "ja"
          },
          {
            "caption": "动词否定",
            "role": "pattern",
            "headers": [
              "形式",
              "例"
            ],
            "rows": [
              [
                "普通体",
                "<bdi>書かない</bdi>"
              ],
              [
                "叮咛体",
                "<bdi>書きません</bdi>"
              ],
              [
                "过去否定",
                "<bdi>書かなかった / 書きませんでした</bdi>"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "名词与形容动词的「<bdi>だ</bdi>」是否定与过去时的变化载体；形容词与动词自带活用。"
      },
      {
        "id": "ja-syntax-question",
        "title": "疑问与其他",
        "tables": [
          {
            "caption": "疑问",
            "role": "pattern",
            "headers": [
              "手段",
              "例"
            ],
            "rows": [
              [
                "终助词 <bdi>か</bdi>",
                "<bdi>学生ですか</bdi>"
              ],
              [
                "疑问词 + <bdi>か</bdi>",
                "<bdi>何を 食べますか</bdi>"
              ],
              [
                "疑问词 + <bdi>も</bdi>（+否定）",
                "<bdi>何も 食べません</bdi>"
              ]
            ],
            "lang": "ja"
          },
          {
            "caption": "其他特征",
            "role": "pattern",
            "headers": [
              "特点",
              "例"
            ],
            "rows": [
              [
                "省略主语（语境明了时）",
                "<bdi>（私は）行きます</bdi>"
              ],
              [
                "敬语由动词形式与句式承担",
                "<bdi>いらっしゃる / お待ちになる</bdi>"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "日语疑问句通常在句末加「<bdi>か</bdi>」，语序不变（不前置疑问词）。"
      }
    ]
  }
]
