[
  {
    "id": "mnc-verb",
    "title": "动词",
    "items": [
      {
        "id": "mnc-verb-general",
        "title": "动词总论：-mbi 形式与词干",
        "tables": [
          {
            "caption": "动词的基本形态",
            "role": "pattern",
            "headers": [
              "项目",
              "形式",
              "说明"
            ],
            "rows": [
              [
                "词典形",
                "ᠠᡵᠠᠮᠪᡳ",
                "以 -ᠮᠪᡳ 结尾，兼表现在-将来时，也是词条的基本形态"
              ],
              [
                "词干",
                "ᠠᡵᠠ-",
                "去掉 -ᠮᠪᡳ；所有后缀都接在词干上（生词表单的「词干」）"
              ],
              [
                "否定",
                "ᠠᡵᠠᡵᠠᡴᡡ",
                "-ᡵᠠ + -ᡴᡡ，元音随词干和谐"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "满语动词只接后缀，不随人称变化（没有人称词尾）；后缀元音与<strong>词干最后一个元音</strong>和谐。"
      },
      {
        "id": "mnc-verb-tense",
        "title": "时制与体",
        "tables": [
          {
            "caption": "时制与体后缀（例：ᠠᡵᠠᠮᠪᡳ 写）",
            "role": "pattern",
            "headers": [
              "形式",
              "后缀",
              "例"
            ],
            "rows": [
              [
                "现在-将来",
                "-ᠮᠪᡳ",
                "ᠠᡵᠠᠮᠪᡳ 写 / 将写"
              ],
              [
                "将来 / 未完成",
                "-ᡵᠠ / -ᡵᡝ / -ᡵᠣ",
                "ᠠᡵᠠᡵᠠ 将要写"
              ],
              [
                "过去",
                "-ᡥᠠ / -ᡥᡝ / -ᡥᠣ",
                "ᠠᡵᠠᡥᠠ 写了"
              ],
              [
                "同时持续",
                "-ᠮᠪᡳᠮᡝ",
                "ᠠᡵᠠᠮᠪᡳᠮᡝ 一边写"
              ],
              [
                "过去进行",
                "-ᠮᠪᡳᡥᡝ",
                "ᠠᡵᠠᠮᠪᡳᡥᡝ 当时正在写"
              ],
              [
                "进行",
                "-ᠮᡝ ᠪᡳ",
                "ᠠᡵᠠᠮᡝ ᠪᡳ 正在写"
              ],
              [
                "进行/持续",
                "-ᠮᡝ ᡳᠯᡳᡥᠠᠪᡳ",
                "ᠠᡵᠠᠮᡝ ᡳᠯᡳᡥᠠᠪᡳ 保持着写的状态"
              ],
              [
                "完成/已毕",
                "-ᠮᠠᡥᠠᠪᡳ",
                "ᠠᡵᠠᠮᠠᡥᠠᠪᡳ 已经写了"
              ],
              [
                "完成",
                "-ᡥᠠ ᠪᡳ",
                "ᠠᡵᠠᡥᠠ ᠪᡳ 已经写了"
              ],
              [
                "过去完成",
                "-ᡥᡝ ᠪᡳᡥᡝ",
                "ᠠᡵᠠᡥᡝ ᠪᡳᡥᡝ 早已写了"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "<code>-ᡥᠠ ᠪᡳ</code> / <code>-ᡥᡝ ᠪᡳᡥᡝ</code> / <code>-ᠮᡝ ᠪᡳ</code> 这类是「后缀 + ᠪᡳ / ᠪᡳᡥᡝ」的复合形式，书写时中间有空格。"
      },
      {
        "id": "mnc-verb-mood",
        "title": "式：命令、祈愿、祈使",
        "tables": [
          {
            "caption": "式",
            "role": "pattern",
            "headers": [
              "形式",
              "后缀",
              "例"
            ],
            "rows": [
              [
                "命令（第二人称）",
                "词干本身",
                "ᠠᡵᠠ 写！"
              ],
              [
                "祈愿（第三人称）",
                "-ᡴᡳᠨᡳ",
                "ᠠᡵᠠᡴᡳᠨᡳ 愿他写"
              ],
              [
                "祈使（第一人称）",
                "-ᠴᡳᠨᠠ",
                "ᠠᡵᠠᠴᡳᠨᠠ 让我写吧"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "-ᡴᡳᠨᡳ / -ᠴᡳᠨᠠ 不随元音和谐变化；命令式的否定见「否定」一节的 ᡠᠮᡝ。"
      },
      {
        "id": "mnc-verb-negation",
        "title": "否定与禁止",
        "tables": [
          {
            "caption": "否定",
            "role": "pattern",
            "headers": [
              "形式",
              "后缀 / 结构",
              "例"
            ],
            "rows": [
              [
                "现在-将来否定",
                "-ᡵᠠᡴᡡ / -ᡵᡝᡴᡡ / -ᡵᠣᡴᡡ",
                "ᠠᡵᠠᡵᠠᡴᡡ 不写"
              ],
              [
                "过去否定",
                "-ᡥᠠᡴᡡ / -ᡥᡝᡴᡡ / -ᡥᠣᡴᡡ",
                "ᠠᡵᠠᡥᠠᡴᡡ 没写"
              ],
              [
                "禁止",
                "ᡠᠮᡝ + -ᡵᠠ / -ᡵᡝ / -ᡵᠣ",
                "ᡠᠮᡝ ᠠᡵᠠᡵᠠ 别写"
              ],
              [
                "名词性否定",
                "ᠠᡴᡡ / ᠸᠠᡴᠠ",
                "ᠠᡴᡡ 没有；ᠸᠠᡴᠠ 不是"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "否定后缀的元音同样随词干和谐；判断句否定用 ᠸᠠᡴᠠ，存在/拥有否定用 ᠠᡴᡡ。"
      },
      {
        "id": "mnc-verb-converb",
        "title": "副动形式（converb）",
        "tables": [
          {
            "caption": "副动后缀",
            "role": "pattern",
            "headers": [
              "形式",
              "后缀",
              "例"
            ],
            "rows": [
              [
                "同时",
                "-ᠮᡝ",
                "ᠠᡵᠠᠮᡝ 一边写"
              ],
              [
                "先后完成",
                "-ᡶᡳ",
                "ᠠᡵᠠᡶᡳ 写完之后"
              ],
              [
                "持续",
                "-ᡥᠠᡳ / -ᡥᡝᡳ / -ᡥᠣᡳ",
                "ᠠᡵᠠᡥᠠᡳ 一直写着"
              ],
              [
                "直到",
                "-ᡨᠠᠯᠠ / -ᡨᡝᠯᡝ",
                "ᠠᡵᠠᡨᠠᠯᠠ 写到…为止"
              ],
              [
                "当…时",
                "-ᠩᡤᠠᠯᠠ / -ᠩᡤᡝᠯᡝ",
                "ᠠᡵᠠᠩᡤᠠᠯᠠ 正要写的时候"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "副动形式不能单独作谓语，只能连接另一个动词或表示伴随状况。"
      },
      {
        "id": "mnc-verb-participle",
        "title": "形动形式与名词化",
        "tables": [
          {
            "caption": "形动与名词化",
            "role": "pattern",
            "headers": [
              "形式",
              "后缀",
              "例"
            ],
            "rows": [
              [
                "已发生（形动）",
                "-ᡥᠠ / -ᡥᡝ / -ᡥᠣ",
                "ᠠᡵᠠᡥᠠ ᠨᡳᠶᠠᠯᠮᠠ 写了的人"
              ],
              [
                "未发生（形动）",
                "-ᡵᠠ / -ᡵᡝ / -ᡵᠣ",
                "ᠠᡵᠠᡵᠠ ᠨᡳᠶᠠᠯᠮᠠ 要写的人"
              ],
              [
                "名词化 -ᠨ",
                "-ᠨ",
                "ᠠᡵᠠᠨ 写的这件事 / 情形"
              ],
              [
                "名词化 -ᠰᡳ",
                "-ᠰᡳ",
                "少数动词"
              ],
              [
                "名词化 -ᡨᠠᠨ / -ᡨᡝᠨ",
                "-ᡨᠠᠨ / -ᡨᡝᠨ",
                "少数动词"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "形动可直接修饰名词，也可作名词用；-ᠨ / -ᠰᡳ / -ᡨᠠᠨ 不太能产。"
      }
    ],
    "derive": {
      "pos": "verb",
      "stemForms": {
        "base": {
          "from": "headword",
          "rules": [
