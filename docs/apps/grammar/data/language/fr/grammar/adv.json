[
  {
    "id": "fr-adv",
    "title": "副词",
    "items": [
      {
        "id": "fr-adv-kinds",
        "title": "常见副词分类",
        "tables": [
          {
            "caption": "按意义分类",
            "role": "pattern",
            "headers": [
              "类别",
              "例"
            ],
            "rows": [
              [
                "时间",
                "<bdi>maintenant、hier、aujourd'hui、toujours、déjà、bientôt</bdi>"
              ],
              [
                "地点",
                "<bdi>ici、là、ailleurs、dedans、dehors、partout</bdi>"
              ],
              [
                "方式",
                "<bdi>bien、mal、ainsi、ensemble、vite</bdi>（不变）"
              ],
              [
                "程度",
                "<bdi>très、trop、assez、beaucoup、peu、presque、tellement</bdi>"
              ],
              [
                "肯定 / 否定",
                "<bdi>oui、si、certainement / non、ne…pas、ne…jamais、ne…plus</bdi>"
              ],
              [
                "疑问",
                "<bdi>où、quand、comment、pourquoi、combien</bdi>"
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "<bdi>vite、tout、bien 等是不规则副词（vite 不作 -ment 变化；tout 有性数变化：tout / toute / tous / toutes）。</bdi>"
      },
      {
        "id": "fr-adv-comparison",
        "title": "副词比较等级",
        "tables": [
          {
            "caption": "比较级与最高级",
            "role": "pattern",
            "headers": [
              "级别",
              "构成",
              "例"
            ],
            "rows": [
              [
                "比较级",
                "<bdi>plus / moins / aussi + 副词 + que</bdi>",
                "<bdi>Il court plus vite que moi.</bdi>"
              ],
              [
                "最高级",
                "<bdi>le plus / le moins</bdi> + 副词",
                "<bdi>Il court le plus vite.</bdi>"
              ],
              [
                "不规则：<bdi>bien</bdi>",
                "<bdi>mieux / le mieux</bdi>",
                "<bdi>Elle chante mieux.</bdi>"
              ],
              [
                "不规则：<bdi>mal</bdi>",
                "<bdi>pis / le pis（口语用 plus mal）</bdi>",
                "—"
              ],
              [
                "不规则：<bdi>beaucoup</bdi>",
                "<bdi>plus / le plus</bdi>",
                "<bdi>Il travaille plus.</bdi>"
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "<bdi>bon 的比较级是 meilleur（形容词），bien 的比较级是 mieux</bdi>（副词），不要混用。"
      },
      {
        "id": "fr-adv-negation",
        "title": "否定结构",
        "tables": [
          {
            "caption": "常见否定",
            "role": "pattern",
            "headers": [
              "结构",
              "含义",
              "例"
            ],
            "rows": [
              [
                "<bdi>ne … pas</bdi>",
                "不",
                "<bdi>Je ne sais pas.</bdi>"
              ],
              [
                "<bdi>ne … jamais</bdi>",
                "从不",
                "<bdi>Il ne vient jamais.</bdi>"
              ],
              [
                "<bdi>ne … plus</bdi>",
                "不再",
                "<bdi>Elle n'habite plus ici.</bdi>"
              ],
              [
                "<bdi>ne … rien</bdi>",
                "什么都不",
                "<bdi>Je ne vois rien.</bdi>"
              ],
              [
                "<bdi>ne … personne</bdi>",
                "不（任何人）",
                "<bdi>Il n'aime personne.</bdi>"
              ],
              [
                "<bdi>ne … aucun</bdi>",
                "一个也不",
                "<bdi>Je n'ai aucune idée.</bdi>"
              ],
              [
                "<bdi>ne … que</bdi>",
                "只（不是真否定）",
                "<bdi>Il ne reste que deux places.</bdi>"
              ],
              [
                "<bdi>ne … ni … ni</bdi>",
                "既不…也不",
                "<bdi>Il ne boit ni café ni thé.</bdi>"
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "口语中常省略 <bdi>ne（Je sais pas</bdi>）；书面语必须保留。"
      }
    ]
  }
]
