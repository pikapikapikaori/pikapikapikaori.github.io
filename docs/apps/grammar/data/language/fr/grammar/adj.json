      {
        "id": "fr-adj-adverb",
        "title": "形容词构造副词（-ment）",
        "tables": [
          {
            "caption": "构成规则",
            "role": "pattern",
            "headers": [
              "形容词结尾",
              "构成",
              "例"
            ],
            "rows": [
              [
                "一般（阳性单数）",
                "阳性单数 + -ment",
                "lent → lentement、heureux → heureusement"
              ],
              [
                "以元音结尾",
                "阳性单数 + -ment",
                "vrai → vraiment、poli → poliment"
              ],
              [
                "阳性以 -ant 结尾",
                "-ant → -amment",
                "courant → couramment、savant → savamment"
              ],
              [
                "阳性以 -ent 结尾",
                "-ent → -emment",
                "récent → récemment、prudent → prudemment"
              ],
              [
                "以 -e 结尾",
                "直接用 -e 形式 + -ment",
                "facile → facilement、rapide → rapidement"
              ]
            ],
            "lang": "fr"
          },
          {
            "caption": "不规则与例外",
            "role": "pattern",
            "headers": [
              "形容词",
