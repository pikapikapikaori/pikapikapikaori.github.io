              [
                "介词 / 副词 + 词",
                "<bdi>chez elle</bdi>",
                "<bdi>[ʃe-zɛl]</bdi>"
              ],
              [
                "介词 / 副词 + 词",
                "<bdi>très utile</bdi>",
                "<bdi>[tʁɛ-zy-til]</bdi>"
              ],
              [
                "数词 + 名词",
                "<bdi>deux enfants</bdi>",
                "<bdi>[dø-zɑ̃-fɑ̃]</bdi>"
              ],
              [
                "数词 + 名词",
