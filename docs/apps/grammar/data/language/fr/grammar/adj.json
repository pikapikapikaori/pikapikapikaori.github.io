      {
        "id": "fr-adj-adverb",
        "title": "形容词构造副词（-<bdi>ment</bdi>）",
        "tables": [
          {
            "caption": "构成规则",
            "role": "pattern",
            "headers": [
              "形容词结尾",
              "构成",
              "例"
            ],
            "rows": [
              [
                "一般（阳性单数）",
                "阳性单数 + -<bdi>ment</bdi>",
                "<bdi>lent → lentement</bdi>、<bdi>heureux → heureusement</bdi>"
              ],
              [
                "以元音结尾",
                "阳性单数 + -<bdi>ment</bdi>",
                "<bdi>vrai → vraiment</bdi>、<bdi>poli → poliment</bdi>"
              ],
              [
                "阳性以 -<bdi>ant</bdi> 结尾",
                "<bdi>-ant → -amment</bdi>",
                "<bdi>courant → couramment</bdi>、<bdi>savant → savamment</bdi>"
              ],
              [
                "阳性以 -<bdi>ent</bdi> 结尾",
                "<bdi>-ent → -emment</bdi>",
                "<bdi>récent → récemment</bdi>、<bdi>prudent → prudemment</bdi>"
              ],
              [
                "以 -<bdi>e</bdi> 结尾",
                "直接用 -e 形式 <bdi>+ -ment</bdi>",
                "<bdi>facile → facilement</bdi>、<bdi>rapide → rapidement</bdi>"
              ]
            ],
            "lang": "fr"
          },
          {
            "caption": "不规则与例外",
            "role": "pattern",
            "headers": [
              "形容词",
              "副词",
              "说明"
            ],
            "rows": [
              [
                "<bdi>bon</bdi>",
                "<bdi>bien</bdi>",
                "规则外的替换"
              ],
              [
                "<bdi>mauvais</bdi>",
                "<bdi>mal</bdi>",
                "规则外的替换"
              ],
              [
                "<bdi>bref</bdi>",
                "<bdi>brièvement</bdi>",
                "<bdi>-f → -ve + ment</bdi>"
              ],
              [
                "<bdi>gentil</bdi>",
                "<bdi>gentiment</bdi>",
                "拼写变化"
              ],
              [
                "<bdi>énorme / immense</bdi>",
                "<bdi>énormément / immensément</bdi>",
                "口语中也常见 -<bdi>ment</bdi>"
              ],
              [
                "<bdi>précipité</bdi>",
                "<bdi>précipitamment</bdi>",
                "保留 -<bdi>amment</bdi> 型"
              ]
            ],
            "lang": "fr"
          },
          {
            "caption": "对照表",
            "role": "pattern",
            "headers": [
              "形容词（阳）",
              "副词",
              "例句"
            ],
            "rows": [
