    "items": [
      {
        "id": "ja-honorific-overview",
        "title": "三类敬语",
        "tables": [
          {
            "caption": "敬语的分类",
            "role": "pattern",
            "headers": [
              "类别",
              "抬高谁",
              "手段",
              "例"
            ],
            "rows": [
              [
                "尊敬語",
                "对方 / 第三者的动作",
                "专用动词、<bdi>お〜になる、ご〜になる、れる / られる</bdi>",
                "<bdi>先生が お書きになった</bdi>"
              ],
              [
                "謙譲語",
                "自己一方的动作（相对降低）",
                "专用动词、<bdi>お〜する、ご〜する、いたす</bdi>",
                "<bdi>私が お書きしました</bdi>"
              ],
              [
                "叮咛语",
                "听话者（整句礼貌化）",
                "<bdi>です・ます・ございます</bdi>",
                "<bdi>本です / 本でございます</bdi>"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "三类各有专门的动词形式（<bdi>見る → ご覧になる / 拝見する</bdi>），具体动词见「动词 · 派生动词」章。"
      },
      {
        "id": "ja-honorific-pattern",
        "title": "敬语句式",
        "tables": [
          {
            "caption": "句式",
            "role": "pattern",
            "headers": [
              "句式",
              "类别",
              "例"
            ],
            "rows": [
              [
                "<bdi>お + 和語词干 + になる</bdi>",
                "尊敬",
                "<bdi>お待ちになる</bdi>"
              ],
              [
                "<bdi>ご + 漢語词干 + になる</bdi>",
                "尊敬",
                "<bdi>ご利用になる</bdi>"
              ],
              [
                "<bdi>お + 和語词干 + する</bdi>",
                "谦让",
                "<bdi>お持ちする</bdi>"
              ],
              [
                "<bdi>ご + 漢語词干 + する</bdi>",
                "谦让",
                "<bdi>ご案内する</bdi>"
              ],
              [
                "<bdi>お + 和語词干 + です</bdi>",
                "叮咛（美化语）",
                "<bdi>お待ちですか</bdi>"
              ],
              [
                "<bdi>〜でございます</bdi>",
                "叮咛（最高级）",
                "<bdi>受付でございます</bdi>"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "<bdi>「お」接和语（日本固有词），「ご」接汉语词；サ変动词用「ご〜する」。</bdi>"
      },
      {
        "id": "ja-honorific-teinei",
        "title": "叮咛语（<bdi>です・ます</bdi>）",
        "tables": [
          {
            "caption": "叮咛体的构成",
            "role": "pattern",
            "headers": [
              "形式",
              "普通体",
              "叮咛体"
            ],
            "rows": [
              [
                "动词（非过去）",
                "<bdi>書く</bdi>",
                "<bdi>書きます</bdi>"
              ],
              [
                "动词（过去）",
                "<bdi>書いた</bdi>",
                "<bdi>書きました</bdi>"
              ],
              [
                "动词（否定）",
                "<bdi>書かない</bdi>",
                "<bdi>書きません</bdi>"
              ],
              [
                "形容词（非过去）",
                "<bdi>高い</bdi>",
                "<bdi>高いです</bdi>"
              ],
              [
                "形容词（过去）",
                "<bdi>高かった</bdi>",
                "<bdi>高かったです</bdi>"
              ],
              [
                "形容词（否定）",
                "<bdi>高くない</bdi>",
                "<bdi>高くないです</bdi>"
              ],
              [
                "<bdi>形容动词・名词</bdi>",
                "<bdi>静かだ / 学生だ</bdi>",
                "<bdi>静かです / 学生です</bdi>"
              ],
              [
                "名词（郑重）",
                "<bdi>本だ</bdi>",
                "<bdi>本でございます</bdi>"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "叮咛语不改变动作的归属，只把整句变得礼貌；<bdi>ます</bdi> 接<strong>連用形1</strong>，<bdi>です</bdi> 接終止形或名词。"
      }
    ]
  }
]
