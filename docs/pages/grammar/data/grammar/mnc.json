                                    "词首形",
                                    "ᠪ",
                                    "b-"
                                ],
                                [
                                    "词中形",
                                    "ᠪ",
                                    "-b-"
                                ],
                                [
                                    "词尾形",
                                    "ᠪ",
                                    "-b"
                                ]
                            ]
                        }
                    ],
                    "notes": "b 与 p 字形相近但不同（p 为 ᡦ）。"
                },
                {
                    "id": "mnc-letter-m-initial",
                    "title": "辅音字母 m 的形态",
                    "tables": [
                        {
                            "caption": "满文辅音 m 的形态",
                            "headers": [
                                "位置",
                                "形式",
                                "罗马化"
                            ],
                            "rows": [
                                [
                                    "独立形",
                                    "ᠮ",
                                    "m"
                                ],
                                [
                                    "词首形",
                                    "ᠮ",
                                    "m-"
                                ],
                                [
                                    "词中形",
                                    "ᠮ",
                                    "-m-"
                                ],
                                [
                                    "词尾形",
                                    "ᠮ",
                                    "-m"
                                ]
                            ]
                        }
                    ],
                    "notes": "m 的形态比较稳定，词尾形通常带一个向下的撇。"
                }
            ]
        },
        {
            "id": "mnc-noun",
            "title": "名词格助词",
            "items": [
                {
                    "id": "mnc-noun-cases",
                    "title": "名词的格系统",
                    "tables": [
                        {
                            "caption": "满语名词的五个格",
                            "headers": [
                                "格",
                                "格助词",
                                "功能",
                                "例"
                            ],
                            "rows": [
                                [
                                    "主格 (Nominative)",
                                    "无",
                                    "主语、施事者",
                                    "ᠪᡳ (bi) 我"
                                ],
                                [
                                    "属格-工具格 (Genitive-Instrumental)",
                                    "ᡳ (i) / ᠨᡳ (ni)",
                                    "所属、工具、材料",
                                    "ᠪᠣᠣ ᡳ ᡝᠵᡝᠨ (boo i ejen) 房的主人"
                                ],
                                [
                                    "与格-方位格 (Dative-Locative)",
                                    "ᡩᡝ (de)",
                                    "间接宾语、地点、时间、方向",
                                    "ᠪᠣᠣ ᡩᡝ (boo de) 在家里 / 向家"
                                ],
                                [
                                    "宾格-经格 (Accusative-Prolative)",
                                    "ᠪᡝ (be)",
                                    "直接宾语、经过的路径",
                                    "ᠪᡳᡨᡥᡝ ᠪᡝ (bithe be) 把书"
                                ],
                                [
                                    "夺格-比格 (Ablative-Comparative)",
                                    "ᠴᡳ (ci)",
                                    "起点、来源、比较基准",
                                    "ᠪᠣᠣ ᠴᡳ (boo ci) 从家 / 比家"
                                ]
                            ]
                        }
                    ],
                    "notes": "满语没有像印欧语那样的形态变格，而是通过在名词后加格助词来表示格关系。格助词 i / ni 的选择取决于前一个词是否以元音或 n 结尾：元音后接 i，n 后接 ni。de 是满语中最常用的格助词之一，功能非常丰富。"
                }
            ]
        },
        {
            "id": "mnc-pron",
            "title": "代词",
            "items": [
                {
                    "id": "mnc-pron-personal",
                    "title": "人称代词",
                    "tables": [
                        {
                            "caption": "人称代词及其格形式",
                            "headers": [
                                "人称",
                                "主格",
                                "属格",
                                "与格",
                                "宾格",
                                "夺格"
                            ],
                            "rows": [
                                [
                                    "1sg",
                                    "ᠪᡳ (bi) 我",
                                    "ᠮᡳᠨᡳ (mini)",
                                    "ᠮᡳᠨᡩᡝ (minde)",
                                    "ᠮᡳᠮᠪᡝ (mimbe)",
                                    "ᠮᡳᠨᠴᡳ (minci)"
                                ],
                                [
                                    "2sg",
                                    "ᠰᡳ (si) 你",
                                    "ᠰᡳᠨᡳ (sini)",
                                    "ᠰᡳᠨᡩᡝ (sinde)",
                                    "ᠰᡳᠮᠪᡝ (simbe)",
                                    "ᠰᡳᠨᠴᡳ (sinci)"
                                ],
                                [
                                    "3sg",
                                    "ᡳ (i) 他/她",
                                    "ᡳᠨᡳ (ini)",
                                    "ᡳᠨᡩᡝ (inde)",
                                    "ᡳᠮᠪᡝ (imbe)",
                                    "ᡳᠨᠴᡳ (inci)"
                                ],
                                [
                                    "1pl（排除）",
                                    "ᠪᡝ (be) 我们",
                                    "ᠮᡝᠨᡳ (meni)",
                                    "ᠮᡝᠨᡩᡝ (mende)",
                                    "ᠮᡝᠮᠪᡝ (membe)",
                                    "ᠮᡝᠨᠴᡳ (menci)"
                                ],
                                [
                                    "1pl（包括）",
                                    "ᠮᡠᠰᡝ (muse) 咱们",
                                    "ᠮᡠᠰᡝᡳ (musei)",
                                    "ᠮᡠᠰᡝᠩᡩᡝ (musende)",
                                    "ᠮᡠᠰᡝᠪᡝ (musebe)",
                                    "ᠮᡠᠰᡝᠴᡳ (museci)"
                                ],
                                [
                                    "2pl",
                                    "ᠰᡠᠸᡝ (suwe) 你们",
                                    "ᠰᡠᠸᡝᠨᡳ (suweni)",
                                    "ᠰᡠᠸᡝᠨᡩᡝ (suwende)",
                                    "ᠰᡠᠸᡝᠮᠪᡝ (suwembe)",
                                    "ᠰᡠᠸᡝᠨᠴᡳ (suwenci)"
                                ],
                                [
                                    "3pl",
                                    "ᠴᡝ (ce) 他们",
                                    "ᠴᡝᠨᡳ (ceni)",
                                    "ᠴᡝᠨᡩᡝ (cende)",
                                    "ᠴᡝᠮᠪᡝ (cembe)",
                                    "ᠴᡝᠨᠴᡳ (cenci)"
                                ]
                            ]
                        }
                    ],
                    "notes": "满语第一人称复数有排除式（be，不包括听话者）和包括式（muse，包括听话者）的区别。人称代词的格形式通过加格助词构成，但部分代词有特殊的缩合形式（如 mini 而非 bi i）。"
                }
            ]
        },
        {
            "id": "mnc-verb",
            "title": "动词",
            "items": [
                {
                    "id": "mnc-verb-tenses",
                    "title": "动词时态",
                    "tables": [
                        {
                            "caption": "满语动词主要时态",
                            "headers": [
                                "时态",
                                "词尾",
                                "例（sambi 知道）"
                            ],
                            "rows": [
                                [
                                    "现在-将来时 (Present-Future)",
                                    "-ᠮᠪᡳ (-mbi)",
                                    "ᠰᠠᠮᠪᡳ (sambi) 知道 / 会知道"
                                ],
                                [
                                    "过去时 (Past)",
                                    "-ᡥᠠ / -ᡥᡝ / -ᡥᠣ (-ha / -he / -ho)",
                                    "ᠰᠠᡥᠠ (saha) 知道了"
                                ],
                                [
                                    "进行体 (Progressive)",
                                    "-ᠮᡝ ᠪᡳ- (-me bi-)",
                                    "ᠰᠠᠮᡝ ᠪᡳ (same bi) 正在知道"
                                ],
                                [
                                    "完成体 (Perfect)",
                                    "-ᡥᠠ ᠪᡳ- (-ha bi-)",
                                    "ᠰᠠᡥᠠ ᠪᡳ (saha bi) 已经知道了"
                                ]
                            ]
                        }
                    ],
                    "notes": "满语动词词尾有元音和谐：-ha 用于后元音词干，-he 用于前元音词干，-ho 用于圆唇元音词干。动词词尾 -mbi 的 -b- 在口语中不发音。满语动词还有丰富的态（主动、被动、使役等）和式（陈述、祈使、条件等）系统。"
                },
                {
                    "id": "mnc-verb-voice",
                    "title": "动词语态",
                    "tables": [
                        {
                            "caption": "动词语态后缀",
                            "headers": [
                                "语态",
                                "后缀",
                                "例"
                            ],
                            "rows": [
                                [
                                    "主动",
                                    "无",
                                    "ᠠᡵᠠᠮᠪᡳ (arambi) 写"
                                ],
                                [
                                    "被动 / 使役",
                                    "-ᠪᡠ (-bu)",
                                    "ᠠᡵᠠᠮᠪᡠᠮᠪᡳ (arambumbi) 被写 / 使写"
                                ],
                                [
                                    "相互",
                                    "-ᠨᡠ / -ᠨᡩᡠ (-nu / -ndu)",
                                    "ᠠᡳᠰᡳᠯᠠᠨᡩᡠᠮᠪᡳ (aisilandumbi) 互相帮助"
                                ],
                                [
                                    "协同",
                                    "-ᠴᠠ / -ᠴᡝ (-ca / -ce)",
                                    "ᠵᠠᡶᠠᠴᠠᠮᠪᡳ (jafacambi) 一起抓"
                                ]
                            ]
                        }
                    ],
                    "notes": "满语的被动和使役共用 -bu 后缀，具体意义由上下文决定。-nu/-ndu 和 -ca/-ce 表示相互或协同动作。"
                }
            ]
        }
    ]
}
