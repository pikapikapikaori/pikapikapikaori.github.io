                "sg": "cheval",
                "pl": "chevaux"
              }
            }
          }
        },
        "tables": [
          {
            "caption": "规则：-<bdi>al → -aux</bdi>",
            "role": "pattern",
            "headers": [
              "情况",
              "说明"
            ],
            "rows": [
              [
                "-<bdi>al</bdi> 结尾",
                "<bdi>-aux</bdi>"
              ],
              [
                "例外",
                "<bdi>bal / carnaval / festival / récital</bdi> 等 + -s"
              ],
              [
                "读音",
                "<bdi>-aux</bdi> 读 [o]"
              ]
            ],
            "lang": "fr"
          },
          {
            "caption": "例词",
            "role": "example",
            "headers": [
              "单数",
              "复数"
            ],
            "rows": [
              [
                "<bdi>cheval</bdi>",
                "<bdi>chevaux</bdi>"
              ],
              [
                "<bdi>journal</bdi>",
                "<bdi>journaux</bdi>"
              ],
              [
                "<bdi>animal</bdi>",
                "<bdi>animaux</bdi>"
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "例外：<bdi>bal / carnaval / festival / récital</bdi> 等加 -s（<bdi>bals</bdi>）。"
