                "ceux-ci",
                "celles-ci"
              ],
              [
                "复合（-là 远指）",
                "celui-là",
                "celle-là",
                "ceux-là",
                "celles-là"
              ]
            ]
          },
          {
            "caption": "中性指示代词",
            "role": "pattern",
            "headers": [
              "形式",
              "用法",
              "例"
            ],
            "rows": [
              [
                "ceci",
                "指下文 / 近指",
                "Écoutez ceci."
              ],
              [
                "cela",
                "指上文 / 远指",
                "Cela est vrai."
              ],
              [
                "ça",
                "cela 的口语形式",
                "Ça va ?"
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "ce 在元音或哑音 h 前变 cet（cet homme）；指示代词 celui 系列常带 -ci / -là 区分远近（celui-ci / celui-là）。"
      },
      {
        "id": "fr-pron-adverbial",
        "title": "副代词 en 与 y",
        "tables": [
          {
            "caption": "en / y",
            "role": "pattern",
            "headers": [
              "代词",
              "代替",
              "例"
            ],
            "rows": [
              [
                "en",
                "de + 名词（部分冠词、数量、来源）",
                "Tu veux du café ? — Oui, j'en veux."
              ],
              [
                "en",
                "数词 / 数量副词后的名词",
                "Combien de livres ? — J'en ai trois."
              ],
              [
                "y",
                "à + 事物 / 地点",
                "Tu penses à ce projet ? — J'y pense."
              ],
              [
                "y",
                "地点「在那里」",
                "Je vais à Paris. — J'y vais."
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "注意：代替「à + 人」用间接宾语代词（lui / leur），不用 y。位置与其它宾语代词相同，置于动词前。"
      },
      {
        "id": "fr-pron-relative",
        "title": "关系代词",
        "tables": [
          {
            "caption": "主要关系代词",
            "role": "pattern",
            "headers": [
              "关系代词",
              "功能",
              "例"
            ],
            "rows": [
              [
                "qui",
                "主语",
                "L'homme qui parle."
              ],
              [
                "que",
                "直接宾语",
                "Le livre que je lis."
              ],
              [
                "où",
                "地点 / 时间",
                "La ville où j'habite."
              ],
              [
                "dont",
                "de + 先行词",
                "L'auteur dont je parle."
              ],
              [
                "lequel / laquelle / lesquels / lesquelles",
                "间接宾语 / 介词后",
                "Le stylo avec lequel j'écris."
              ],
              [
                "auquel / à laquelle / auxquels / auxquelles",
                "à + 先行词",
                "Le projet auquel je pense."
              ],
              [
                "duquel / de laquelle / desquels / desquelles",
                "de + 先行词",
                "Le pays duquel il vient."
              ]
            ]
          }
        ],
        "notes": "que 在从句中作宾语，遇元音省音（l'homme qu'il voit）；dont = de + 先行词；où 兼指时间与地点。"
      },
      {
        "id": "fr-pron-interrogative",
        "title": "疑问代词",
        "tables": [
          {
            "caption": "疑问代词",
            "role": "pattern",
            "headers": [
              "形式",
              "指人 / 指物",
              "例"
            ],
            "rows": [
              [
                "qui",
                "只指人",
                "Qui vient ?"
              ],
              [
                "que / qu'est-ce que",
                "只指物",
                "Que fais-tu ?"
              ],
              [
                "quoi",
                "指物（介词后 / 口语）",
                "À quoi penses-tu ?"
              ],
              [
                "lequel / laquelle / lesquels / lesquelles",
                "指人或物（有限选择）",
                "Lequel préfères-tu ?"
              ],
              [
                "quel / quelle / quels / quelles",
                "疑问形容词",
                "Quel livre ?"
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "qui 作主语时动词用第三人称单数；口语常用「qui est-ce qui / qu'est-ce que」结构。"
      },
      {
        "id": "fr-pron-indefinite",
