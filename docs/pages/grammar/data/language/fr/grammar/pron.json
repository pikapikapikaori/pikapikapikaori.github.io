          {
            "caption": "第二人称",
            "role": "pattern",
            "headers": [
              "",
              "单数",
              "复数"
            ],
            "rows": [
              [
                "主语",
                "tu",
                "vous"
              ],
              [
                "直接宾语",
                "te",
                "vous"
              ],
              [
                "间接宾语",
                "te",
                "vous"
              ],
              [
