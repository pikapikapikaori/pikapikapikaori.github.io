      {
        "id": "fr-noun-gender",
        "title": "性与数",
        "tables": [
          {
            "caption": "名词的性与数",
            "role": "pattern",
            "headers": [
              "",
              "单数",
              "复数"
            ],
            "rows": [
              [
                "阳性",
                "le livre",
                "les livres"
              ],
              [
                "阴性",
                "la table",
                "les tables"
              ]
            ]
          },
          {
            "caption": "常见复数规则",
            "role": "pattern",
            "headers": [
              "单数结尾",
              "复数规则",
              "例"
            ],
            "rows": [
              [
                "一般",
                "+ -s",
                "livre → livres"
              ],
              [
                "-s, -x, -z",
                "不变",
                "voix → voix, nez → nez"
              ],
              [
                "-al",
                "-al → -aux",
                "cheval → chevaux"
              ],
              [
                "-eau, -au, -eu",
                "+ -x",
                "beau → beaux, feu → feux"
              ],
              [
                "-ou（部分）",
                "+ -x",
                "bijou → bijoux, genou → genoux"
              ],
              [
                "-ail（部分）",
                "-ail → -aux",
                "travail → travaux"
              ],
              [
                "-s / -x / -z 结尾",
                "不变",
                "fils → fils"
              ]
            ]
          }
        ],
        "notes": "法语名词的性别需按词记忆：以 -tion / -té / -ette / -elle / -ance / -ence 结尾多为阴性，以 -ment / -age / -isme / -eau 结尾多为阳性。"
      },
