[
  {
    "id": "ja-verb",
    "title": "动词总论",
    "items": [
      {
        "id": "ja-verb-overview",
        "title": "活用形体系与四类动词",
        "tables": [
          {
            "caption": "活用形（学校文法）",
            "role": "pattern",
            "headers": [
              "活用形",
              "作用",
              "五段 書く",
              "一段 食べる",
              "する",
              "来る"
            ],
            "rows": [
              [
                "未然形",
                "接 ない・う/よう・れる・せる",
                "書か",
                "食べ",
                "し / せ / さ",
                "こ"
              ],
              [
                "連用形1",
                "接 ます・たい・ながら",
                "書き",
                "食べ",
                "し",
                "き"
              ],
              [
                "連用形2（音便）",
                "接 て・た",
                "書い",
                "食べ",
                "し",
                "き"
              ],
              [
                "終止形（辞書形）",
                "结句",
                "書く",
                "食べる",
                "する",
                "くる"
              ],
              [
                "連体形",
                "修饰名词",
                "書く",
                "食べる",
                "する",
                "くる"
              ],
              [
                "已然形（仮定）",
                "接 ば",
                "書け",
                "食べれ",
                "すれ",
                "くれ"
              ],
              [
                "命令形",
                "命令",
                "書け",
                "食べろ",
                "しろ / せよ",
                "こい"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "动词按活用方式分<strong>四类</strong>：五段・一段・サ変（する）・カ変（来る）。生词表单里选对应的锚点后，填辞书形即可自动生成全部活用形与合成形式。連用形2（音便）只在五段与 て/た 结合时才有独立形状（書い / 書いて），其余三类与連用形1 同形。"
      },
      {
        "id": "ja-verb-compound",
        "title": "合成形式的构成",
        "tables": [
          {
            "caption": "形式与活用形的对应",
            "role": "pattern",
            "headers": [
              "形式",
              "构成",
              "例（書く）"
            ],
            "rows": [
              [
                "ます形（叮咛）",
                "連用形1 + ます",
                "書きます"
              ],
              [
                "ない形",
                "未然形 + ない",
                "書かない"
              ],
              [
                "た形",
                "連用形2 + た",
                "書いた"
              ],
              [
                "て形",
                "連用形2 + て",
                "書いて"
              ],
              [
                "意志形",
                "未然形 + う / よう",
                "書こう"
              ],
              [
                "可能形",
                "五段：已然形 + る；一段等：未然形 + られる",
                "書ける / 食べられる"
              ],
              [
                "受身形",
                "未然形 + れる / られる",
                "書かれる"
              ],
              [
                "使役形",
                "未然形 + せる / させる",
                "書かせる"
              ],
              [
                "使役受身形",
                "未然形 + せられる / させられる",
                "書かせられる"
              ],
              [
                "仮定形＋ば",
                "已然形 + ば",
                "書けば"
              ]
            ],
            "lang": "ja"
          }
        ],
        "notes": "口语里可能形与使役受身形有缩约形：食べられる → 食べれる、書かせられる → 書かされる。"
      }
    ]
  },
