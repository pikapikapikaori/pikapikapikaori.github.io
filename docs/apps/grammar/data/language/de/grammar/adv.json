[
  {
    "id": "de-adv",
    "title": "副词",
    "items": [
      {
        "id": "de-adv-kinds",
        "title": "副词分类",
        "tables": [
          {
            "caption": "按意义分类",
            "role": "pattern",
            "headers": [
              "类别",
              "例"
            ],
            "rows": [
              [
                "时间",
                "<bdi>jetzt</bdi>、<bdi>heute</bdi>、<bdi>gestern</bdi>、<bdi>morgen</bdi>、<bdi>bald</bdi>、<bdi>immer</bdi>"
              ],
              [
                "地点",
                "<bdi>hier</bdi>、<bdi>dort</bdi>、<bdi>oben</bdi>、<bdi>unten</bdi>、<bdi>links</bdi>、<bdi>rechts</bdi>"
              ],
              [
                "方向",
                "<bdi>hin</bdi>、<bdi>her</bdi>、<bdi>hinauf</bdi>、<bdi>herunter</bdi>"
              ],
              [
                "方式",
                "<bdi>gern</bdi>、<bdi>schnell</bdi>、<bdi>so</bdi>、<bdi>anders</bdi>、<bdi>zusammen</bdi>"
              ],
              [
                "程度",
                "<bdi>sehr</bdi>、<bdi>ziemlich</bdi>、<bdi>fast</bdi>、<bdi>ganz</bdi>、<bdi>nur</bdi>、<bdi>sogar</bdi>"
              ],
              [
                "情态 / 语气",
                "<bdi>doch</bdi>、<bdi>ja</bdi>、<bdi>wohl</bdi>、<bdi>mal</bdi>、<bdi>eben</bdi>"
              ],
              [
                "否定",
                "<bdi>nicht</bdi>、<bdi>nie</bdi>、<bdi>niemals</bdi>、<bdi>keineswegs</bdi>"
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "德语形容词与副词同形（<bdi>schnell</bdi> 既是「快的」也是「快地」），只有少数词（<bdi>gern</bdi>、<bdi>bald</bdi>）专门用作副词。"
      },
      {
        "id": "de-adv-comparison",
        "title": "副词比较等级",
        "tables": [
          {
            "caption": "规则比较等级",
            "role": "pattern",
            "headers": [
              "",
              "比较级",
              "最高级"
            ],
            "rows": [
              [
                "<bdi>schnell</bdi>（快）",
                "<bdi>schneller</bdi>",
                "<bdi>am schnellsten</bdi>"
              ],
              [
                "<bdi>laut</bdi>（大声）",
                "<bdi>lauter</bdi>",
                "<bdi>am lautesten</bdi>"
              ],
              [
                "<bdi>früh</bdi>（早）",
                "<bdi>früher</bdi>",
                "<bdi>am frühesten</bdi>"
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "规则副词用 -<bdi>er / am …-sten</bdi> 构成比较级与最高级（与形容词同形）。下表是常用的不规则形式。"
      },
      {
        "id": "de-adv-pronominal",
        "title": "代副词 <bdi>da(r)-</bdi> 与 <bdi>wo(r</bdi>)-",
        "tables": [
          {
            "caption": "构成与用法",
            "role": "pattern",
            "headers": [
              "形式",
              "用途",
              "例"
            ],
            "rows": [
              [
                "<bdi>da</bdi> + 介词",
                "代替「介词 + 事物」",
                "<bdi>damit</bdi>、<bdi>dafür</bdi>、<bdi>darüber</bdi>"
              ],
              [
                "<bdi>da + r</bdi> + 元音开头介词",
                "介词以元音开头时插入 <bdi>r</bdi>",
                "<bdi>darauf</bdi>、<bdi>daran</bdi>、<bdi>darum</bdi>"
              ],
              [
                "<bdi>wo</bdi> + 介词",
                "对「介词 + 事物」提问",
                "<bdi>womit</bdi>、<bdi>wovon</bdi>、<bdi>worüber</bdi>"
              ],
              [
                "<bdi>wo + r</bdi> + 元音开头介词",
                "同上",
                "<bdi>worauf</bdi>、<bdi>woran</bdi>、<bdi>worin</bdi>"
              ]
            ],
            "lang": "de"
          },
          {
            "caption": "人 <bdi>vs</bdi> 物",
            "role": "pattern",
            "headers": [
              "所指",
              "用什么",
              "例"
            ],
            "rows": [
              [
                "指物",
                "代副词",
                "<bdi>Worauf wartest du? — Auf den Bus.</bdi>"
              ],
              [
                "指人",
                "介词 + 人称代词",
                "<bdi>Auf wen wartest du? — Auf meinen Freund.</bdi>"
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "<bdi>da(r)- / wo(r</bdi>)- 只用于指物；指人时要用「介词 + 人称代词」。"
      }
    ]
  }
]
