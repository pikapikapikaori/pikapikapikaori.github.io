[
  {
    "id": "grc-adv",
    "title": "副词",
    "items": [
      {
        "id": "grc-adv-comparison",
        "title": "副词的比较级与最高级",
        "tables": [
          {
            "caption": "构成规则",
            "role": "pattern",
            "headers": [
              "级别",
              "构成",
              "例"
            ],
            "rows": [
              [
                "原级",
                "形容词词干 + -<bdi>ως</bdi>（第一二变格）<bdi>/ -ῶς</bdi>（第三变格）",
                "<bdi>σοφῶς</bdi> 聪明地、<bdi>ἀληθῶς</bdi> 真实地"
              ],
              [
                "比较级",
                "比较级形容词的中性宾格单数（-<bdi>τερον / -ιον</bdi>）",
                "<bdi>σοφώτερον</bdi>、<bdi>ἀληθέστερον</bdi>"
              ],
              [
                "最高级",
                "最高级形容词的中性宾格复数（-<bdi>τατα / -ιστα</bdi>）",
                "<bdi>σοφώτατα</bdi>、<bdi>ἀληθέστατα</bdi>"
              ]
            ],
            "lang": "grc"
          },
          {
            "caption": "不规则",
            "role": "pattern",
            "headers": [
              "原级",
              "比较级",
              "最高级"
            ],
            "rows": [
              [
                "<bdi>εὖ</bdi> 好",
                "<bdi>ἄμεινον / βέλτιον</bdi>",
                "<bdi>ἄριστα / βέλτιστα</bdi>"
              ],
              [
                "<bdi>κακῶς</bdi> 坏",
                "<bdi>χεῖρον / κάκιον</bdi>",
                "<bdi>κάκιστα</bdi>"
              ],
              [
                "<bdi>μάλα</bdi> 很",
                "<bdi>μᾶλλον</bdi>",
                "<bdi>μάλιστα</bdi>"
              ],
              [
                "<bdi>ταχέως</bdi> 快",
                "<bdi>θᾶττον</bdi>",
                "<bdi>τάχιστα</bdi>"
              ]
            ],
            "lang": "grc"
          }
        ],
        "notes": "副词化时只用中性形式，因此副词本身没有性数格变化；比较对象用属格或 <bdi>ἤ</bdi> 引出。"
      },
      {
        "id": "grc-adv-place",
        "title": "方位副词（名词的三种方位形式）",
        "tables": [
          {
            "caption": "三种方位与词尾",
            "role": "pattern",
            "headers": [
              "方位",
              "词尾",
              "例"
            ],
            "rows": [
              [
                "位置（在哪）",
                "<bdi>-οι / -θι</bdi>",
                "<bdi>οἴκοι</bdi> 在家、<bdi>Ἀθήνησι(ν)</bdi> 在雅典、<bdi>θύρασι</bdi> 在门外"
              ],
              [
                "趋向（往哪）",
                "<bdi>-δε / -σε</bdi>",
                "<bdi>οἴκαδε</bdi> 回家、<bdi>Ἀθήναζε</bdi> 往雅典、<bdi>ἄλαδε</bdi> 向海"
              ],
              [
                "来源（从哪）",
                "<bdi>-θεν</bdi>",
                "<bdi>οἴκοθεν</bdi> 从家、<bdi>Ἀθήνηθεν</bdi> 从雅典、<bdi>οὐρανόθεν</bdi> 从天"
              ]
            ],
            "lang": "grc"
          },
          {
            "caption": "例词",
            "role": "example",
            "headers": [
              "名词",
              "位置",
              "趋向",
              "来源"
            ],
            "rows": [
              [
                "<bdi>οἶκος</bdi> 家",
                "<bdi>οἴκοι</bdi>",
                "<bdi>οἴκαδε</bdi>",
                "<bdi>οἴκοθεν</bdi>"
              ],
              [
                "<bdi>Ἀθῆναι</bdi> 雅典",
                "<bdi>Ἀθήνησι(ν)</bdi>",
                "<bdi>Ἀθήναζε</bdi>",
                "<bdi>Ἀθήνηθεν</bdi>"
              ],
              [
                "<bdi>θάλασσα</bdi> 海",
                "—",
                "<bdi>θάλασσανδε / ἄλαδε</bdi>",
                "<bdi>θαλάσσηθεν</bdi>"
              ],
              [
                "<bdi>οὐρανός</bdi> 天",
                "—",
                "<bdi>οὐρανόνδε</bdi>",
                "<bdi>οὐρανόθεν</bdi>"
              ]
            ],
            "lang": "grc"
          }
        ],
        "notes": "-<bdi>δε / -σε</bdi> 与 <bdi>-θεν</bdi> 直接加在名词词干（多为宾格 / 属格形式）后，属于构词而非变格，因此不需要格词尾。"
      },
      {
        "id": "grc-adv-kinds",
        "title": "常见副词分类",
        "tables": [
          {
            "caption": "按意义分类",
            "role": "pattern",
            "headers": [
              "类别",
              "例"
            ],
            "rows": [
              [
                "时间",
                "<bdi>νῦν</bdi> 现在、<bdi>τότε</bdi> 那时、<bdi>αἰεί</bdi> 永远、<bdi>ἤδη</bdi> 已经、<bdi>αὖθις</bdi> 再"
              ],
              [
                "地点",
                "<bdi>ἐνθάδε</bdi> 这里、<bdi>ἐκεῖ</bdi> 那里、<bdi>πανταχοῦ</bdi> 到处、<bdi>ἔσω</bdi> 在内"
              ],
              [
                "方式",
                "<bdi>οὕτως</bdi> 这样、<bdi>ὡς</bdi> 如、<bdi>ἅμα</bdi> 同时、<bdi>σφόδρα</bdi> 非常"
              ],
              [
                "程度",
                "<bdi>μάλα</bdi> 很、<bdi>πάνυ</bdi> 十分、<bdi>ἥκιστα</bdi> 最少"
              ],
              [
                "语气",
                "<bdi>δή</bdi> 的确、<bdi>γε</bdi> 至少、<bdi>μέν / δέ</bdi> 一方面 / 另一方面"
              ],
              [
                "否定",
                "<bdi>οὐ / οὐκ / οὐχ</bdi> 不、<bdi>μή</bdi> 不（非陈述）、<bdi>οὐκέτι</bdi> 不再"
              ]
            ],
            "lang": "grc"
          }
        ],
        "notes": "副词没有形态变化（比较等级除外）；否定副词 <bdi>οὐ</bdi> 用于陈述句，<bdi>μή</bdi> 用于祈使、虚拟、祈愿与条件句。"
      }
    ]
  }
]
