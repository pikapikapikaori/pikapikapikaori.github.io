[
  {
    "id": "fr-adv",
    "title": "副词",
    "items": [
      {
        "id": "fr-adv-kinds",
        "title": "常见副词分类",
        "tables": [
          {
            "caption": "按意义分类",
            "role": "pattern",
            "headers": [
              "类别",
              "例"
            ],
            "rows": [
              [
                "时间",
                "maintenant、hier、aujourd'hui、toujours、déjà、bientôt"
              ],
              [
                "地点",
                "ici、là、ailleurs、dedans、dehors、partout"
              ],
              [
                "方式",
                "bien、mal、ainsi、ensemble、vite（不变）"
              ],
              [
                "程度",
                "très、trop、assez、beaucoup、peu、presque、tellement"
              ],
              [
                "肯定 / 否定",
                "oui、si、certainement / non、ne…pas、ne…jamais、ne…plus"
              ],
              [
                "疑问",
                "où、quand、comment、pourquoi、combien"
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "vite、tout、bien 等是不规则副词（vite 不作 -ment 变化；tout 有性数变化：tout / toute / tous / toutes）。"
      },
      {
        "id": "fr-adv-comparison",
        "title": "副词比较等级",
        "tables": [
          {
            "caption": "比较级与最高级",
            "role": "pattern",
            "headers": [
              "级别",
              "构成",
              "例"
            ],
            "rows": [
              [
                "比较级",
                "plus / moins / aussi + 副词 + que",
                "Il court plus vite que moi."
              ],
              [
                "最高级",
                "le plus / le moins + 副词",
                "Il court le plus vite."
              ],
              [
                "不规则：bien",
                "mieux / le mieux",
                "Elle chante mieux."
              ],
              [
                "不规则：mal",
                "pis / le pis（口语用 plus mal）",
                "—"
              ],
              [
                "不规则：beaucoup",
                "plus / le plus",
                "Il travaille plus."
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "bon 的比较级是 meilleur（形容词），bien 的比较级是 mieux（副词），不要混用。"
      },
      {
        "id": "fr-adv-negation",
        "title": "否定结构",
        "tables": [
          {
            "caption": "常见否定",
            "role": "pattern",
            "headers": [
              "结构",
              "含义",
              "例"
            ],
            "rows": [
              [
                "ne … pas",
                "不",
                "Je ne sais pas."
              ],
              [
                "ne … jamais",
                "从不",
                "Il ne vient jamais."
              ],
              [
                "ne … plus",
                "不再",
                "Elle n'habite plus ici."
              ],
              [
                "ne … rien",
                "什么都不",
                "Je ne vois rien."
              ],
              [
                "ne … personne",
                "不（任何人）",
                "Il n'aime personne."
              ],
              [
                "ne … aucun",
                "一个也不",
                "Je n'ai aucune idée."
              ],
              [
                "ne … que",
                "只（不是真否定）",
                "Il ne reste que deux places."
              ],
              [
                "ne … ni … ni",
                "既不…也不",
                "Il ne boit ni café ni thé."
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "口语中常省略 ne（Je sais pas）；书面语必须保留。"
      }
    ]
  }
]
