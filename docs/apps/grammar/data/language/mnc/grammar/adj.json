      {
        "id": "mnc-adj-comparison",
        "title": "比较与程度",
        "tables": [
          {
            "caption": "比较结构",
            "role": "pattern",
            "headers": [
              "结构",
              "例",
              "说明"
            ],
            "rows": [
              [
                "基准 + -<bdi>ᠴᡳ</bdi> + 形容词",
                "<bdi>ᠪᡳ ᠰᡳᠨᠴᡳ ᠠᠮᠪᠠ</bdi>",
                "我比你大：基准用夺格 -<bdi>ᠴᡳ</bdi>"
              ],
              [
                "程度副词 + 形容词",
                "<bdi>ᡠᡵᡤᡠᠨᠵᡝᠴᡠᡴᡝ ᠰᠠᡳᠨ</bdi>",
                "很好"
              ],
              [
                "指小 -<bdi>ᡴᠠᠨ/-ᡴᡝᠨ/-ᡴᠣᠨ</bdi>",
                "<bdi>ᠠᠮᠪᠠᡴᠠᠨ</bdi>",
                "稍大"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "比较不用专门的比较级形式：用夺格 -<bdi>ᠴᡳ</bdi> 引出基准；指小后缀随词干和谐。"
      },
