  {
    "id": "mnc-verb-secondary",
    "title": "派生动词",
    "items": [
      {
        "id": "mnc-verb-voice-overview",
        "title": "四类语态概览",
        "tables": [
          {
            "caption": "语态",
            "role": "pattern",
            "headers": [
              "语态",
              "后缀",
              "例"
            ],
            "rows": [
              [
                "主动",
                "无",
                "<bdi>ᠠᡵᠠᠮᠪᡳ</bdi> 写"
              ],
              [
                "被动 / 使役",
                "<bdi>-ᠪᡠ</bdi>",
                "<bdi>ᠠᡵᠠᠪᡠᠮᠪᡳ</bdi> 被写 / 使写"
              ],
              [
                "相互",
                "<bdi>-ᠨᡠ / -ᠨᡩᡠ</bdi>",
                "<bdi>ᠠᡳᠰᡳᠯᠠᠨᡩᡠᠮᠪᡳ</bdi> 互相帮助"
              ],
              [
                "协同",
                "<bdi>-ᠴᠠ / -ᠴᡝ</bdi>",
                "<bdi>ᠵᠠᡶᠠᠴᠠᠮᠪᡳ</bdi> 一起抓"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "主动式没有专门后缀；其余三类都用后缀派生<strong>新词</strong>（词干改变），不是同一个词的形式变化。"
      },
      {
        "id": "mnc-verb-voice-bu",
        "title": "使役 / 被动（-bu）",
        "tables": [
          {
            "caption": "构成",
            "role": "pattern",
            "headers": [
              "要素",
              "形式"
            ],
            "rows": [
              [
                "词干",
                "原词干 + -<bdi>ᠪᡠ-</bdi>（<bdi>ᠠᡵᠠᠮᠪᡳ → ᠠᡵᠠᠮᠪᡠ</bdi>-）"
              ],
              [
                "词义",
                "「使…做」或「被…做」—— 同形，靠上下文区分"
              ],
              [
                "变位",
                "完全按普通动词接后缀（-<bdi>ᠮᠪᡳ / -ᡥᠠ / -ᡵᠠ / -ᡵᡝ / -ᡵᠣ / -ᠮᡝ</bdi>…）"
              ],
              [
                "示例",
                "<bdi>ᠠᡵᠠᠮᠪᡳ</bdi> 写 <bdi>→ ᠠᡵᠠᠮᠪᡠᠮᠪᡳ</bdi> 被写 / 使写"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "派生后的词干照常参与元音和谐：<bdi>ᠠᡵᠠᠮᠪᡠ-</bdi> 是后元音 <bdi>→ ᠠᡵᠠᠮᠪᡠᡥᠠ</bdi>；<bdi>ᡤᡝᠨᡝᠪᡠ-</bdi> 是前元音 <bdi>→ ᡤᡝᠨᡝᠪᡠᡥᡝ</bdi>。"
      },
      {
        "id": "mnc-verb-voice-nu",
        "title": "相互（-nu / -ndu）",
        "tables": [
          {
            "caption": "构成",
            "role": "pattern",
            "headers": [
              "要素",
              "形式"
            ],
            "rows": [
              [
                "词干",
                "原词干 + -<bdi>ᠨᡠ- / -ᠨᡩᡠ</bdi>-"
              ],
              [
                "词义",
                "「互相…」"
              ],
              [
                "变位",
                "同普通动词"
              ],
              [
                "示例",
                "<bdi>ᠠᡳᠰᡳᠯᠠᠮᠪᡳ</bdi> 帮助 <bdi>→ ᠠᡳᠰᡳᠯᠠᠨᡩᡠᠮᠪᡳ</bdi> 互相帮助"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "-<bdi>ᠨᡩᡠ</bdi> 多接在以 <bdi>-ᠨ</bdi> 结尾的词干后（<bdi>ᠠᡳᠰᡳᠯᠠ- → ᠠᡳᠰᡳᠯᠠᠨᡩᡠ</bdi>-）；同样按派生后的词干继续和谐。"
      },
      {
