            "rows": [
              [
                "<bdi>livre</bdi>",
                "<bdi>livres</bdi>"
              ],
              [
                "<bdi>table</bdi>",
                "<bdi>tables</bdi>"
              ],
              [
                "<bdi>étudiant</bdi>",
                "<bdi>étudiants</bdi>"
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "绝大多数名词在单数形式后加 -s；-s 本身不发音。"
