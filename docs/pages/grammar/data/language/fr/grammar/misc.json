              ],
              [
                "à + les",
                "aux",
                "aux enfants"
              ],
              [
                "de + la / de + l'",
                "不缩合",
                "de la table / de l'eau"
              ],
              [
                "à + la / à + l'",
                "不缩合",
                "à la plage / à l'école"
              ],
              [
                "de + un / une / des",
                "不缩合（不定冠词）",
                "de un → d'un（省音），une / des 不变"
              ]
            ]
          }
        ],
        "notes": "只有阳性单数 le 与复数 les 才与 de / à 缩合；阴性 la 与省音形式 l' 不缩合。"
      }
    ]
  },
  {
    "id": "fr-orthography",
    "title": "正字法",
    "items": [
      {
        "id": "fr-orthography-accents",
        "title": "音符与特殊字符",
        "tables": [
          {
            "caption": "五种音符",
            "role": "pattern",
            "headers": [
              "音符",
              "名称",
              "作用",
              "例"
            ],
            "rows": [
              [
                "é",
                "accent aigu（闭音符）",
                "只出现在 e 上，表示 [e]",
                "été、parler"
              ],
              [
                "è / ê",
                "accent grave / circonflexe",
                "表示 [ɛ]；ê 常来自历史上消失的 s",
                "père、forêt（forest）"
              ],
              [
                "à / ù",
                "accent grave",
                "只用来区分同形词",
                "à（介词）、où（哪里）"
              ],
              [
                "â / î / ô / û",
                "accent circonflexe",
                "标记历史上的长音或消失的字母",
                "âme、île、hôtel、dû"
              ],
              [
                "ë / ï / ü",
                "tréma（分音符）",
                "表示与前一元音分开读，不构成双元音",
                "Noël、maïs、aiguë"
              ],
              [
                "ç",
                "cédille（软音符）",
                "让 c 在 a / o / u 前读 [s]",
                "français、reçu、leçon"
              ],
              [
                "œ",
                "ligature",
                "o + e 的合字",
                "cœur、œuf、sœur"
              ]
            ],
            "lang": "fr"
          },
          {
            "caption": "易混词",
            "role": "pattern",
            "headers": [
              "带音符",
              "不带音符",
              "区别"
            ],
            "rows": [
              [
                "à（介词）",
                "a（avoir 的第三人称单数）",
                "Il a à faire."
              ],
              [
                "ou（或者）",
                "où（哪里）",
                "Tu viens ou non ? / Où es-tu ?"
              ],
              [
                "la（冠词）",
                "là（那里）",
                "la table / là-bas"
              ],
              [
                "sur（在…上）",
                "sûr（确定的）",
                "sur la table / je suis sûr"
              ],
              [
                "du（部分冠词）",
                "dû（devoir 的过去分词）",
                "du pain / j'ai dû partir"
              ],
              [
                "notre（我们的）",
                "nôtre（物主代词）",
                "notre maison / le nôtre"
              ]
            ],
            "lang": "fr"
          }
        ],
        "notes": "音符是拼写的一部分，不能省略；打字时可以用输入法的法语布局或组合键。"
      },
