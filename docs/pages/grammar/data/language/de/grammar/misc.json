      {
        "id": "de-prep-contraction",
        "title": "介词与冠词的缩合",
        "tables": [
          {
            "caption": "常见缩合形式",
            "role": "pattern",
            "headers": [
              "缩合",
              "原形",
              "例"
            ],
            "rows": [
              [
                "am",
                "an + dem",
                "am Bahnhof"
              ],
              [
                "ans",
                "an + das",
                "ans Fenster gehen"
              ],
              [
                "im",
                "in + dem",
                "im Haus"
              ],
              [
                "ins",
                "in + das",
                "ins Kino gehen"
              ],
              [
                "aufs",
                "auf + das",
                "aufs Land fahren"
              ],
              [
                "beim",
                "bei + dem",
                "beim Arzt"
              ],
              [
                "vom",
                "von + dem",
                "vom Bahnhof"
              ],
              [
                "zum",
                "zu + dem",
                "zum Bahnhof"
              ],
              [
                "zur",
                "zu + der",
                "zur Schule"
              ],
              [
                "durchs / fürs / ums",
                "durch + das / für + das / um + das",
                "ums Haus gehen"
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "介词与定冠词常缩合，缩合后一般不再分开写（zum = zu dem）；需要强调冠词时用分开形式（zu dem Mann, den ich meine）。zum / zur 也用于不定式名词化前（zum Lesen）。"
      }
    ]
  },
  {
    "id": "de-order",
    "title": "语序",
    "items": [
      {
        "id": "de-order-main",
        "title": "主句：动词第二位",
        "tables": [
          {
            "caption": "基本规则",
            "role": "pattern",
            "headers": [
              "成分位置",
              "规则",
              "例"
            ],
            "rows": [
              [
                "第 1 位",
                "主语 / 时间 / 其他成分（只能有一个）",
                "Ich fahre morgen nach Berlin."
              ],
              [
                "第 2 位",
                "<strong>变位动词</strong>",
                "Morgen fahre ich nach Berlin."
              ],
              [
                "句末",
                "不定式 / 过去分词 / 可分前缀",
                "Ich muss heute arbeiten. / Ich stehe früh auf."
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "主句只有「变位动词固定在第二位」这一条硬规则；第 1 位放什么由强调决定。"
      },
      {
        "id": "de-order-sub",
        "title": "从句：动词末位",
        "tables": [
          {
            "caption": "连词与语序",
            "role": "pattern",
            "headers": [
              "连词类型",
              "语序",
              "例"
            ],
            "rows": [
              [
                "并列连词（und, aber, oder, denn, sondern）",
                "正常语序",
                "Ich bleibe hier, aber er geht."
              ],
              [
                "从属连词（weil, dass, wenn, ob, als, obwohl…）",
                "变位动词到句末",
                "Ich bleibe hier, weil es regnet."
              ],
              [
                "关系代词",
                "动词到句末",
                "Der Mann, den ich kenne, …"
              ],
              [
                "间接疑问",
                "动词到句末",
                "Ich weiß nicht, ob er kommt."
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "从句里助动词 / 情态动词在最后，实义动词在它前面：…, weil ich heute arbeiten muss。"
      },
      {
        "id": "de-order-frame",
        "title": "框型结构与成分顺序",
        "tables": [
          {
            "caption": "框型结构（Satzklammer）",
            "role": "pattern",
            "headers": [
              "结构",
              "框的前半",
              "框的后半"
            ],
            "rows": [
              [
                "情态动词 + 不定式",
                "muss",
                "arbeiten"
              ],
              [
                "完成时",
                "habe",
                "gemacht"
              ],
              [
                "可分动词",
                "stehe",
                "auf"
              ],
              [
                "被动",
                "wird",
                "gemacht"
              ]
            ],
            "lang": "de"
          },
          {
            "caption": "多个状语时的顺序（TeKaMoLo）",
            "role": "pattern",
            "headers": [
              "顺序",
              "类别",
              "例"
            ],
            "rows": [
              [
                "1",
                "Temporal（时间）",
                "heute"
              ],
              [
                "2",
                "Kausal（原因）",
                "wegen des Regens"
              ],
              [
                "3",
                "Modal（方式）",
                "mit dem Bus"
              ],
              [
                "4",
                "Lokal（地点）",
                "nach Berlin"
              ],
              [
                "完整例句",
                "—",
                "Ich fahre heute wegen des Regens mit dem Bus nach Berlin."
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "TeKaMoLo 只是默认顺序，强调时可前置到句首（此时主语后移到动词后）。"
      },
      {
        "id": "de-order-negation",
        "title": "否定与 nicht 的位置",
        "tables": [
          {
            "caption": "nicht 的位置",
            "role": "pattern",
            "headers": [
              "否定对象",
              "位置",
              "例"
            ],
            "rows": [
              [
                "整句否定",
                "尽量靠句末，但在句末的动词部分之前",
                "Ich kenne ihn nicht. / Ich habe ihn nicht gesehen."
              ],
              [
                "情态动词 / 可分动词句",
                "在不定式或可分前缀之前",
                "Ich kann heute nicht kommen. / Er steht nicht auf."
              ],
              [
                "否定某个成分",
                "紧放在该成分前",
                "Ich fahre nicht morgen, sondern übermorgen."
              ],
              [
                "否定介词短语",
                "在介词短语前",
                "Er wohnt nicht in Berlin."
              ],
              [
                "否定名词",
                "改用 kein（kein / keine / kein）",
                "Ich habe kein Geld. / Er hat keine Zeit."
              ]
            ],
            "lang": "de"
          },
          {
            "caption": "其他否定词",
            "role": "pattern",
            "headers": [
              "形式",
              "含义",
              "例"
            ],
            "rows": [
              [
                "nie / niemals",
                "从不",
                "Er kommt nie zu spät."
              ],
              [
                "nichts / niemand",
                "没有东西 / 没有人",
                "Ich sehe nichts."
              ],
              [
                "nicht mehr",
                "不再",
                "Er wohnt nicht mehr hier."
              ],
              [
                "noch nicht",
                "还没",
                "Ich bin noch nicht fertig."
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "判断 nicht 的位置先问「否定的是什么」：否定整句就靠后（但必须在句末动词 / 过去分词 / 不定式之前），否定某个成分就紧放在它前面；名词用 kein 否定。nicht 与 kein 不叠加（✗ Ich habe nicht ein Auto → ✓ Ich habe kein Auto）。"
      }
    ]
  },
  {
    "id": "de-orthography",
    "title": "正字法",
    "items": [
      {
        "id": "de-orthography-sharp-s",
        "title": "ß 与 ss",
        "tables": [
          {
            "caption": "规则",
            "role": "pattern",
            "headers": [
              "情况",
              "写法",
              "例"
            ],
            "rows": [
              [
                "长元音或双元音之后",
                "ß",
                "Straße、groß、heißen"
              ],
              [
                "短元音之后",
                "ss",
                "Fluss、müssen、dass"
              ],
              [
                "瑞士与列支敦士登",
                "一律用 ss",
                "Strasse、gross"
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "1996 年正字法改革后，ß 只保留在长元音 / 双元音之后；短元音后一律写 ss。"
      },
      {
        "id": "de-orthography-capital",
        "title": "名词大写",
        "tables": [
          {
            "caption": "大写规则",
            "role": "pattern",
            "headers": [
              "情况",
              "大写",
              "例"
            ],
            "rows": [
              [
                "所有名词",
                "要",
                "der Tisch、die Freiheit"
              ],
              [
                "句首",
                "要",
                "Heute ist es kalt."
              ],
              [
                "尊称 Sie / Ihr",
                "要",
                "Kommen Sie?"
              ],
              [
                "名词化的形容词 / 动词",
                "要",
                "das Gute、das Lesen"
              ],
              [
                "语言 / 形容词 / 副词",
                "不要",
                "deutsch、schnell"
              ],
              [
                "星期 / 月份",
                "要",
                "Montag、Januar"
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "与法语相反：德语名词、星期、月份都大写，而语言名与形容词小写（但作名词时大写：das Deutsche）。"
      },
      {
        "id": "de-orthography-separate",
        "title": "分写与合写",
        "tables": [
          {
            "caption": "常见情况",
            "role": "pattern",
            "headers": [
              "情况",
              "写法",
              "例"
            ],
            "rows": [
              [
                "可分动词的不定式",
                "合写",
                "aufstehen、einkaufen"
              ],
              [
                "主句中的可分动词",
                "分写",
                "Ich stehe früh auf."
              ],
              [
                "名词 + 名词的复合词",
                "合写",
                "Haustür、Kindergarten"
              ],
              [
                "形容词 + 动词",
                "通常分写",
                "schnell laufen"
              ],
              [
                "动词 + 动词",
                "可分前缀合写，其余分写",
                "kennenlernen / spazieren gehen"
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "复合词合写时，性由最后一个词决定（die Haus + die Tür → die Haustür）。"
      },
      {
        "id": "de-orthography-punctuation",
        "title": "标点与引号",
        "tables": [
          {
            "caption": "标点与符号",
            "role": "pattern",
            "headers": [
              "符号",
              "用法",
              "例"
            ],
            "rows": [
              [
                "„…“",
                "主引号（先下后上），书籍与媒体也用 »…«",
                "Er sagte: „Ich komme morgen.“"
              ],
              [
                "‚…‘",
                "引号内的引号",
                "Sie sagte: „Er meinte ‚vielleicht‘.“"
              ],
              [
                "–",
                "破折号（Gedankenstrich），前后各一个空格",
                "Ich komme – wenn ich Zeit habe."
              ],
              [
                "-",
                "连字符，前后不加空格",
                "David-Bowie-Straße、3-jährig"
              ],
              [
                "…",
                "省略号（一个字符）",
                "Ich wollte sagen, dass …"
              ],
              [
                "'",
                "省音撇号：省略 e",
                "Wie geht's? / Ich hab' keine Zeit."
              ],
              [
                ":",
                "冒号后小写（除非是整句或名词）",
                "Er sagte nur eines: nein."
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "德语引号方向与英语相反：开引号在下方（„），闭引号在上方（“）；替代写法是 »…«。破折号用 – （Halbgeviertstrich）并前后空格，不用英语的 — 连写。行末拆分时 ß 不拆（旧规则的 ss 拆写已废），复合词按成分拆（Haus-tür）。"
      }
    ]
  }
]
