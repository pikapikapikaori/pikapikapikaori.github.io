      {
        "id": "mnc-noun-cases",
        "title": "格助词",
        "tables": [
          {
            "caption": "五个格及其格助词",
            "role": "pattern",
            "headers": [
              "格",
              "格助词",
              "功能",
              "例"
            ],
            "rows": [
              [
                "主格",
                "无",
                "主语、判断句的主题",
                "ᠪᠣᠣ 房子"
              ],
              [
                "属格-工具格",
                "ᡳ / ᠨᡳ",
                "所属、材料、工具；元音后接 i，n 后接 ni",
                "ᠪᠣᠣ ᡳ ᡝᠵᡝᠨ 房主"
              ],
              [
                "与格-方位格",
                "ᡩᡝ",
                "间接宾语、地点、时间、方向",
                "ᠪᠣᠣ ᡩᡝ 在家里 / 向家"
              ],
              [
                "宾格-经格",
                "ᠪᡝ",
                "直接宾语；经过的路径",
                "ᠪᡳᡨᡥᡝ ᠪᡝ 把书"
              ],
              [
                "夺格-比格",
                "ᠴᡳ",
                "起点、来源、比较基准",
                "ᠪᠣᠣ ᠴᡳ 从家 / 比房子"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "满语没有形态上的变格，格关系由<strong>格助词</strong>表示，名词词形本身不变；格助词接在整个名词短语末尾（ᠪᠣᠣ ᡳ ᡝᠵᡝᠨ = 房子 + 属格 + 主人）。"
      },
      {
        "id": "mnc-noun-possessive",
        "title": "领属与「有 / 没有」",
        "tables": [
          {
            "caption": "常见表达",
            "role": "pattern",
            "headers": [
              "结构",
              "例",
              "说明"
            ],
            "rows": [
              [
                "名词 + ᡳ + 名词",
                "ᠮᡳᠨᡳ ᠪᠣᠣ",
                "我的房子（代词属格 + 名词）"
              ],
              [
                "有：名词 + ᠪᡳ",
                "ᠪᠣᠣ ᠪᡳ",
                "有房子"
              ],
              [
                "没有：名词 + ᠠᡴᡡ",
                "ᠪᠣᠣ ᠠᡴᡡ",
                "没有房子"
              ]
            ],
            "lang": "mnc"
          }
        ],
        "notes": "满语没有专门的「有」动词，用 ᠪᡳ / ᠠᡴᡡ 表示存在与否定。"
      }
