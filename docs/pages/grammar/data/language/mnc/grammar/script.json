[
  {
    "id": "mnc-script",
    "title": "满文字母与书写",
    "items": [
      {
        "id": "mnc-script-vowels",
        "title": "元音字母（6）",
        "tables": [
          {
            "caption": "元音字母的四种位置形式",
            "role": "pattern",
            "headers": [
              "转写",
              "独立形",
              "词首形",
              "词中形",
              "词尾形",
              "说明"
            ],
            "rows": [
              [
                "a",
                "‌ᠠ‌",
                "ᠠ‍",
                "‍ᠠ‍",
                "‍ᠠ",
                "独立形与词首形不同（独立形多一笔）；单独成词时用独立形"
              ],
              [
                "e",
                "‌ᡝ‌",
                "ᡝ‍",
                "‍ᡝ‍",
                "‍ᡝ",
                "独立形与词首形不同；属前元音组"
              ],
              [
                "i",
                "‌ᡳ‌",
                "ᡳ‍",
                "‍ᡳ‍",
                "‍ᡳ",
                "独立形与词首形不同；中性元音"
              ],
              [
                "o",
                "‌ᠣ‌",
                "ᠣ‍",
                "‍ᠣ‍",
                "‍ᠣ",
                "圆唇元音，可单独成词（o = 「和」）"
              ],
              [
                "u",
                "‌ᡠ‌",
                "ᡠ‍",
                "‍ᡠ‍",
                "‍ᡠ",
                "前元音（与 e 同组）"
              ],
              [
                "ū",
                "‌ᡡ‌",
                "ᡡ‍",
                "‍ᡡ‍",
                "‍ᡡ",
                "后元音（与 a 同组），与 u 是两个不同字母"
              ]
            ],
            "lang": "mnc"
          }
        ]
      },
      {
        "id": "mnc-script-consonants",
        "title": "辅音字母（19）",
        "tables": [
          {
            "caption": "辅音字母的四种位置形式",
            "role": "pattern",
            "headers": [
              "转写",
              "独立形",
              "词首形",
              "词中形",
              "词尾形",
              "说明"
            ],
            "rows": [
              [
                "n",
                "‌ᠨ‌",
                "ᠨ‍",
                "‍ᠨ‍",
                "‍ᠨ",
                "词尾形带下撇"
              ],
              [
                "ng",
                "‌ᠩ‌",
                "ᠩ‍",
                "‍ᠩ‍",
                "‍ᠩ",
                "只用于词中、词尾，不能作词首"
              ],
              [
                "k",
                "‌ᡴ‌",
                "ᡴ‍",
                "‍ᡴ‍",
                "‍ᡴ",
                "与 g、h 共用基本字形：g 加点、h 加小圈；后接前元音（e / i / u）时字形变窄"
              ],
              [
                "g",
                "‌ᡤ‌",
                "ᡤ‍",
                "‍ᡤ‍",
                "‍ᡤ",
                "见 k"
              ],
              [
                "h",
                "‌ᡥ‌",
                "ᡥ‍",
                "‍ᡥ‍",
                "‍ᡥ",
                "见 k"
              ],
              [
                "b",
                "‌ᠪ‌",
                "ᠪ‍",
                "‍ᠪ‍",
                "‍ᠪ",
                "与 p 是两个不同字母，字形相近，不可混用"
              ],
              [
                "p",
                "‌ᡦ‌",
                "ᡦ‍",
                "‍ᡦ‍",
                "‍ᡦ",
                "见 b"
              ],
              [
                "s",
                "‌ᠰ‌",
                "ᠰ‍",
                "‍ᠰ‍",
                "‍ᠰ",
                "与 š 同为齿音，š 加区别符号"
              ],
              [
                "š",
                "‌ᡧ‌",
                "ᡧ‍",
                "‍ᡧ‍",
                "‍ᡧ",
                "见 s"
              ],
              [
                "t",
                "‌ᡨ‌",
                "ᡨ‍",
                "‍ᡨ‍",
                "‍ᡨ",
                "与 d 同基形"
              ],
              [
                "d",
                "‌ᡩ‌",
                "ᡩ‍",
                "‍ᡩ‍",
                "‍ᡩ",
                "在 t 的基形上加一点"
              ],
              [
                "m",
                "‌ᠮ‌",
                "ᠮ‍",
                "‍ᠮ‍",
                "‍ᠮ",
                "与 n、l 同族"
              ],
              [
                "l",
                "‌ᠯ‌",
                "ᠯ‍",
                "‍ᠯ‍",
                "‍ᠯ",
                "与 m、n 同族"
              ],
              [
                "r",
                "‌ᡵ‌",
                "ᡵ‍",
                "‍ᡵ‍",
                "‍ᡵ",
                "词尾形带下撇"
              ],
              [
                "j",
                "‌ᠵ‌",
                "ᠵ‍",
                "‍ᠵ‍",
                "‍ᠵ",
                "词中、词尾形带下撇"
              ],
              [
                "c",
                "‌ᠴ‌",
                "ᠴ‍",
                "‍ᠴ‍",
                "‍ᠴ",
                "词尾形带下撇"
              ],
              [
                "f",
                "‌ᡶ‌",
                "ᡶ‍",
                "‍ᡶ‍",
                "‍ᡶ",
                "词首形与词中形差别较大"
              ],
              [
                "w",
                "‌ᠸ‌",
                "ᠸ‍",
                "‍ᠸ‍",
                "‍ᠸ",
                "词尾形带下撇"
              ],
              [
                "y",
                "‌ᠶ‌",
                "ᠶ‍",
                "‍ᠶ‍",
                "‍ᠶ",
                "中性，可与前、后元音共现"
              ]
            ],
            "lang": "mnc"
          }
        ]
      },
      {
        "id": "mnc-script-dotted",
        "title": "带点字母（3）",
        "tables": [
          {
            "caption": "带点字母的四种位置形式",
            "role": "pattern",
            "headers": [
              "转写",
              "独立形",
              "词首形",
              "词中形",
              "词尾形",
              "说明"
            ],
            "lang": "mnc",
            "rows": [
              [
                "k'",
                "‌ᡣ‌",
                "ᡣ‍",
                "‍ᡣ‍",
                "‍ᡣ",
                "k 加点，只出现在 e、i 前（与 a、o、ū 前的 k 区分）"
              ],
              [
                "g'",
                "‌ᡬ‌",
                "ᡬ‍",
                "‍ᡬ‍",
                "‍ᡬ",
                "g 加点，只出现在 e、i 前"
              ],
              [
                "h'",
                "‌ᡭ‌",
                "ᡭ‍",
                "‍ᡭ‍",
                "‍ᡭ",
                "h 加点（小圈），只出现在 e、i 前"
              ]
            ]
          }
        ],
        "notes": "表里的四种字形同样是<strong>同一个 Unicode 码位</strong>，位置形由字体按上下文决定；单元格里的零宽连接符只用于强制排版，复制时请只复制字母本身。"
      },
      {
        "id": "mnc-script-loan",
        "title": "汉语借词字母（9）",
        "tables": [
          {
            "caption": "汉语借词字母的四种位置形式",
            "role": "pattern",
            "headers": [
              "转写",
              "独立形",
              "词首形",
              "词中形",
              "词尾形",
              "说明"
            ],
            "lang": "mnc",
            "rows": [
              [
                "ts",
                "‌ᡮ‌",
                "ᡮ‍",
                "‍ᡮ‍",
                "‍ᡮ",
                "汉语借词的 ts"
              ],
              [
                "ts'",
                "‌ᡱ‌",
                "ᡱ‍",
                "‍ᡱ‍",
                "‍ᡱ",
                "送气的 ts'"
              ],
              [
                "dz",
                "‌ᡯ‌",
                "ᡯ‍",
                "‍ᡯ‍",
                "‍ᡯ",
                "汉语借词的 dz"
              ],
              [
                "dz'",
                "‌ᡰ‌",
                "ᡰ‍",
                "‍ᡰ‍",
                "‍ᡰ",
                "送气的 dz'"
              ],
              [
                "ž",
                "‌ᡷ‌",
                "ᡷ‍",
                "‍ᡷ‍",
                "‍ᡷ",
                "借词 / 外来音的 ž"
              ],
              [
                "j'",
                "‌ᡪ‌",
                "ᡪ‍",
                "‍ᡪ‍",
                "‍ᡪ",
                "j 加点"
              ],
              [
                "c'",
                "‌ᡲ‌",
                "ᡲ‍",
                "‍ᡲ‍",
                "‍ᡲ",
                "c 加点"
              ],
              [
                "s'",
                "‌ᡸ‌",
                "ᡸ‍",
                "‍ᡸ‍",
                "‍ᡸ",
                "s 加点（Unicode 名 CHA WITH TWO DOTS）"
              ],
              [
                "f'",
                "‌ᡫ‌",
                "ᡫ‍",
                "‍ᡫ‍",
                "‍ᡫ",
                "f 加点"
              ]
            ]
          }
        ],
        "notes": "表里的四种字形同样是<strong>同一个 Unicode 码位</strong>，位置形由字体按上下文决定；单元格里的零宽连接符只用于强制排版，复制时请只复制字母本身。"
      },
      {
        "id": "mnc-script-rules",
        "title": "书写与连接规则",
        "tables": [
          {
            "caption": "规则",
            "role": "pattern",
            "headers": [
              "规则",
              "说明"
            ],
            "lang": "mnc",
            "rows": [
              [
                "方向",
                "满文自上而下竖写，列自左向右（本表格为了排版改为横排）"
              ],
              [
                "连写",
                "一个词内部字母相连，不断开；词与词之间留空"
              ],
              [
                "位置形",
                "同一个字母在词首 / 词中 / 词尾 / 单独成词时取不同字形，由字体按上下文自动选择"
              ],
              [
                "独立形",
                "只有单独成词时才用（如 o「和」、i「他」）"
              ],
              [
                "词的界线",
                "词首形 / 词尾形只出现在词的两端，词中间的字母一律用词中形"
              ],
              [
                "带点字母",
                "k' / g' / h' 只用在 e、i 前；a、o、ū 前用不带点的 k / g / h"
              ],
              [
                "借词字母",
                "汉语借词用 ts / ts' / dz / dz' / ž 与带点的 j' / c' / s' / f' 等字形转写外来音"
              ],
              [
                "转写规则",
                "双字母优先：ng、ts'、dz'、k'、g'、h'、j'、c'、s'、f' 按整组识别，撇号本身不写出；词内的空格保留，词首 / 词尾的连字符去掉"
              ]
            ]
          }
        ],
        "notes": "表里的四种字形其实是<strong>同一个 Unicode 码位</strong>，位置形由字体按上下文决定；为了把四种形状并排显示，单元格里用了零宽连接符（ZWJ / ZWNJ）强制指定位置，复制到别处时请只复制字母本身。"
      }
    ]
  }
]
