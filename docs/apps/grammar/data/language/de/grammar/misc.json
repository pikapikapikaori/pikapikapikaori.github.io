                "<bdi>gegenüber dem Bahnhof</bdi>"
              ]
            ],
            "lang": "de"
          }
        ],
        "notes": "记住口诀「<bdi>aus, bei, mit, nach, seit, von, zu — 后面永远与格」。gegenüber</bdi> 常放在名词后。"
      },
      {
        "id": "de-prep-two-way",
        "title": "两可介词（<bdi>Wechselpräpositionen</bdi>）",
        "tables": [
